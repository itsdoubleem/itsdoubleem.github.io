---
/* The picture of an app on the homepage. It is a real screenshot of the shipping build,
   produced by tools/capture-guide.mjs — not a drawing, and not a mock-up. An earlier
   version of this component rebuilt LOGGER's punch screen by hand in HTML and CSS; it
   drifted from the app almost immediately (wrong button text, wrong pad, a whole card
   missing). Do not reintroduce that. An app with no screenshot falls back to its icon. */
interface Props { name: string; icon: string; card?: string; }
const { name, icon, card } = Astro.props;
---
<div class="preview">
  {card ? (
    <img class="preview__shot" src={card} alt={`${name} running on a phone`}
         width="390" height="844" loading="lazy" decoding="async" />
  ) : (
    <div class="preview__fallback">
      <img src={icon} alt="" width="56" height="56" loading="lazy" decoding="async" />
      <span>{name}</span>
    </div>
  )}
</div>

<style>
  /* The screenshot is of a light app on a dark site, so it arrives as a bright rectangle
     and there is no dimming it — that would be showing the reader something other than
     what they will get. What the frame does instead is give it a dark well to sit in, so
     the brightness reads as the screen being on rather than as a hole in the page. */
  /* ── The 390px ceiling lives here now ──
     It used to live on the grid's column width, which meant the only way to stop a
     screenshot being magnified was to stop the card growing — and that left ragged
     empty space at the end of every short row. The cap belongs on the picture: the
     card can be any width it likes, and the capture is never drawn larger than the
     390 CSS px it was taken at (card.png is 1170px for a 390px layout; see DESIGN.md
     § The app card). In a wider card it simply centres, mounted on the card's surface. */
  .preview {
    max-width: 390px;
    margin-inline: auto;
    aspect-ratio: 3 / 4;
    border-radius: var(--r-md);
    overflow: hidden;
    background: var(--ground);
    border: 1px solid var(--hairline);
  }
  /* Anchored to the top: the header, the date and the punch pad are what make the app
     recognisable, and they live in the first two thirds of the screen. */
  .preview__shot { width: 100%; height: 100%; object-fit: cover; object-position: top; }

  .preview__fallback {
    height: 100%;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 10px;
    font-weight: 700; letter-spacing: -0.01em;
  }
  .preview__fallback img { border-radius: 12px; }
</style>
