---
/* A deck of small true things, flipped through with no JavaScript at all.
 *
 * The mechanism is a radio group: one hidden radio per card, and every visible control is
 * a <label> pointing at one of them. Checking a radio reveals its card through a sibling
 * selector. That is why the source order is radios first, then cards — the combinator only
 * reaches forward, so nothing may move above the inputs.
 *
 * Why not JavaScript: this site ships zero script tags, the about page says so, and a
 * LOGGER claim invites people to count the requests. A toy is not worth making three
 * honest sentences false. It also means the deck works with JS off, which the design
 * notes require of every page.
 *
 * The show/highlight rules are generated below rather than hand-written, so adding an
 * entry to curios.ts is the only edit needed. They are injected with `is:inline` because
 * Astro cannot scope a stylesheet it did not author — the ID in each selector carries
 * enough specificity to beat the scoped `display: none`.
 */
import { curios } from '../curios';

/* This took a `num` prop so the page could number its section heads — "02 — Deck",
 * "03 — Deck" depending on what sat above it. The ordinals were removed from the
 * section heads on 2026-09-20 and the prop went with them; there is nothing left for a
 * caller to pass. See DESIGN.md § The kicker. */

/* ── The starfield ──
 * Each layer is ONE element carrying a small SVG tile as its background, repeated.
 *
 * ── It was radial-gradients, and that froze the page on a real phone ──
 * The first version built each layer's background out of 8–26 stacked CSS
 * radial-gradients. It looked identical to this and it was unusable: measured on a
 * Galaxy S24 Ultra over USB, scrolling the homepage produced frames of **974–1481ms** —
 * second-long freezes, which is exactly what "it gets stuck when scrolling" felt like.
 *
 * The cost is rasterising a stack of gradients at that device's 3.75x pixel ratio, and
 * nothing tuned it away. Measured on the device, every one of these still stalled:
 * smaller tiles, two layers instead of four, `will-change: auto`, no animation at all.
 * Only removing the star layers entirely was clean.
 *
 * One SVG tile per layer is clean. Chrome rasterises the tile once and repeats the
 * bitmap, where a gradient stack is re-rasterised across the whole layer:
 *
 *     radial-gradient stars  frames= 97   max= 974ms   stalls=1
 *     SVG tile stars         frames=174   max=  25ms   stalls=0
 *     no stars at all        frames=177   max=  33ms   stalls=0
 *
 * So: if you change how these layers are drawn, measure it on a phone, not in a desktop
 * browser. A desktop at 1x never showed this at all.
 *
 * The positions are still generated from a FIXED SEED so the same sky comes out of every
 * build — a random field would re-roll on each deploy and fill the diff with noise.
 */
function field(seed: number, count: number, w: number, h: number, r: number, alpha: number) {
  let s = seed >>> 0;
  const next = () => ((s = (Math.imul(s, 1664525) + 1013904223) >>> 0) / 4294967296);
  let dots = '';
  for (let i = 0; i < count; i++) {
    const x = (next() * w).toFixed(1);
    const y = (next() * h).toFixed(1);
    // Vary each star's brightness, or the field reads as a regular grid of identical dots.
    const o = (alpha * (0.4 + next() * 0.6)).toFixed(2);
    dots += `<circle cx='${x}' cy='${y}' r='${r}' fill='%23e4fff4' opacity='${o}'/>`;
  }
  // %23 rather than # — a literal hash ends the URL. Single quotes inside so the whole
  // thing can sit in a double-quoted url().
  return `url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' width='${w}' height='${h}'>${dots}</svg>")`;
}

/* Tile sizes are the loop distance as well as the texture size: each layer is one tile
 * larger than the section and drifts by exactly one tile, so the loop is seamless. */
const sky = {
  far:   { f: field(20260920, 10, 190, 150, 0.7, 0.55), w: 190, h: 150 },
  mid:   { f: field(70112358, 7,  150, 120, 0.9, 0.75), w: 150, h: 120 },
  nearA: { f: field(31415927, 5,  230, 180, 1.2, 0.95), w: 230, h: 180 },
  nearB: { f: field(27182818, 4,  200, 160, 1.1, 0.90), w: 200, h: 160 },
};

const rules = curios
  .map(
    (_, i) => `
#curio-${i}:checked ~ .curio__card--${i} { display: block; }
#curio-${i}:focus-visible ~ .curio__card--${i} {
  outline: 2px solid var(--accent); outline-offset: 3px;
}`,
  )
  .join('');
---

<section class="curio wrap" aria-labelledby="curio-head">
  {/* ── The sky ──
      Decoration, and it obeys the same rules as the page's own glow and grid: it holds
      no text, it takes no pointer, and the section is complete without it. It is masked
      to fade out at every edge, so it belongs to this section rather than ending in a
      rectangle — the same treatment the page grid gets in global.css.

      Scoped to the section's own box rather than bled to 100vw. A full-bleed layer is
      the more dramatic version and it is how this page has twice grown a horizontal
      scrollbar; the mask does most of the same work with none of that risk. */}
  <div class="sky" aria-hidden="true">
    <div class="sky__neb"></div>
    <div class="sky__limb"></div>
    {(['far','mid','nearA','nearB'] as const).map((k, i) => (
      <div
        class={`sky__layer sky__layer--${['far','mid','near-a','near-b'][i]}`}
        style={`--f: ${sky[k].f}; --tw: ${sky[k].w}px; --th: ${sky[k].h}px`}
      ></div>
    ))}
  </div>

  <header>
    <div class="sec">
      <h2 class="display display--sec sec__title" id="curio-head">One true thing</h2>
      <p class="sec__note">
        Every one of the {curios.length} says where you can check it.
      </p>
    </div>
  </header>

  <div class="curio__deck">
    {curios.map((_, i) => (
      <input
        class="curio__radio"
        type="radio"
        name="curio"
        id={`curio-${i}`}
        checked={i === 0}
        aria-label={`Show item ${i + 1} of ${curios.length}`}
      />
    ))}

    {curios.map((c, i) => (
      <article class={`curio__card curio__card--${i}`}>
        <p class="curio__kind">{c.kind}</p>

        {c.attribution ? (
          <blockquote class="curio__quote">
            <p>“{c.lead}”</p>
            <footer>{c.attribution}</footer>
          </blockquote>
        ) : (
          <p class="curio__ask">{c.lead}</p>
        )}

        {c.reveal && (
          <details class="curio__reveal">
            <summary>Show me</summary>
            <p>{c.reveal}</p>
          </details>
        )}

        <p class="curio__source">
          {c.sourceUrl ? <a href={c.sourceUrl}>{c.source}</a> : c.source}
        </p>

        <div class="curio__foot">
          <div class="curio__moves">
            <label class="curio__next" for={`curio-${(i + 1) % curios.length}`}>
              Another one <span aria-hidden="true">→</span>
            </label>
            <label
              class="curio__back"
              for={`curio-${(i - 1 + curios.length) % curios.length}`}
            >
              <span aria-hidden="true">←</span> Back
            </label>
          </div>
          <p class="curio__count">{i + 1} of {curios.length}</p>
        </div>
      </article>
    ))}

  </div>
</section>

<style is:inline set:html={rules}></style>

<style>
  .curio {
    margin-top: clamp(44px, 6vw, 78px);
    position: relative;
    /* Nothing inside .sky may reach the page. The layers are deliberately larger than
       this box so their drift never exposes an edge, and without this they would widen
       the document — the same bug the hero's bloom and the app head's backdrop both
       caused before they were clipped. `clip`, not `hidden`: hidden makes this a scroll
       container, which would break the focus ring the deck relies on. */
    overflow: clip;
    padding-block: clamp(30px, 4vw, 54px);
  }

  /* ---------- the cosmos ---------- */
  .sky {
    position: absolute;
    inset: 0;
    pointer-events: none;
    /* Fades to nothing at every edge so the field has no border. Same idea as the
       page grid's mask in global.css — a texture the section stands in, not a
       rectangle drawn on it. */
    -webkit-mask-image: radial-gradient(118% 104% at 50% 42%, #000 28%, transparent 100%);
    mask-image: radial-gradient(118% 104% at 50% 42%, #000 28%, transparent 100%);
  }

  /* The nebula does NOT move, and that is deliberate. DESIGN.md § Motion: a pulsing or
     drifting glow is the one change to this design that would make it look cheap. The
     stars drift; the light they are in holds still. */
  .sky__neb {
    position: absolute;
    inset: -30% -10%;
    background:
      radial-gradient(38% 52% at 22% 18%, color-mix(in oklab, var(--accent) 16%, transparent) 0%, transparent 70%),
      radial-gradient(46% 60% at 82% 72%, rgba(90, 150, 200, 0.10) 0%, transparent 72%),
      radial-gradient(70% 80% at 50% 100%, var(--glow-soft) 0%, transparent 76%);
  }

  /* A planet's limb, mostly below the fold of the section: one enormous circle with a
     hairline edge. It is the cheapest cue there is that this is space rather than a
     dark panel with dots on it, and it costs one element and no motion. */
  .sky__limb {
    position: absolute;
    left: 50%;
    top: 62%;
    width: 178%;
    aspect-ratio: 1;
    translate: -50% 0;
    border-radius: 50%;
    border: 1px solid color-mix(in oklab, var(--accent) 13%, transparent);
    background: radial-gradient(closest-side, color-mix(in oklab, var(--accent) 4%, transparent) 0%, transparent 72%);
  }

  /* One element per depth, each tiled and each drifting at its own speed — which is the
     whole of the parallax. The element is a full tile larger than the section in both
     axes, and the animation translates it by exactly one tile, so the loop is seamless
     and no edge is ever exposed. Change --tw/--th and the keyframe follows automatically. */
  .sky__layer {
    position: absolute;
    top: 0;
    left: 0;
    width: calc(100% + var(--tw));
    height: calc(100% + var(--th));
    background-image: var(--f);
    background-size: var(--tw) var(--th);
    background-repeat: repeat;
    /* No `will-change: transform`. It was here, and measured on the device it bought
       nothing — 174 frames with it, 173 without, the same 25ms worst frame — while
       permanently promoting four full-section layers into GPU memory. An animated
       transform is promoted by the compositor anyway. */
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Slow enough that you never catch it moving — you only notice it has moved. The
       near layers also breathe, on two different periods so they are never in step;
       one shared period would read as the whole sky blinking. */
    .sky__layer--far    { animation: sky-drift 280s linear infinite; }
    .sky__layer--mid    { animation: sky-drift 190s linear infinite; }
    .sky__layer--near-a { animation: sky-drift 130s linear infinite, sky-twinkle 7s ease-in-out infinite; }
    .sky__layer--near-b { animation: sky-drift 104s linear infinite, sky-twinkle 9.5s ease-in-out -3.2s infinite; }

    @keyframes sky-drift {
      from { transform: translate3d(0, 0, 0); }
      to   { transform: translate3d(calc(var(--tw) * -1), calc(var(--th) * -1), 0); }
    }
    @keyframes sky-twinkle {
      0%, 100% { opacity: 1; }
      50%      { opacity: .55; }
    }
  }

  /* Everything real sits above the sky. */
  .curio > header,
  .curio__deck { position: relative; z-index: 1; }

  /* Capped to a reading measure rather than stretched across the page: a card running
     twice as wide as the sentence introducing it reads as an accident.

     This used to carry `margin-left: 196px` — the 148px metadata rail plus its 48px gap —
     so that the deck lined up with the section title rather than with the page edge. The
     rail is gone and the title is flush left now, so the indent that once aligned them
     would be the one thing on the page that is not. */
  /* Full measure, not 760px. The card was the last block on the catalogue page that
     stopped short of the right edge while everything above it reached it — see the
     note in apps/index.astro about why that raggedness read as mess. The measure that
     matters is the one on the TEXT inside, which is capped separately below; the card
     around it may be as wide as the page. */
  .curio__deck { margin-top: clamp(28px, 4vw, 44px); }

  /* Focusable but invisible: the Back and Another one labels are the visible controls, and
     the card itself takes the focus ring when its radio is focused. Never display:none
     here — that would take the whole group out of the tab order and off the keyboard,
     which is what makes arrow keys walk the deck. */
  .curio__radio {
    position: absolute;
    width: 1px; height: 1px;
    margin: -1px; padding: 0; border: 0;
    clip-path: inset(50%);
    overflow: hidden; white-space: nowrap;
  }

  /* The 3px accent left border is gone. A white rounded card with a coloured stripe
     down one side is the alert component every utility framework ships, and it was
     spending the page's one accent on something that is not clickable. */
  /* Frosted, not solid — and here that is not a style choice, it is the reason the sky
     was worth drawing. DESIGN.md § The atmosphere: a glass panel over a flat opaque
     surface is just a grey box, and it only reads as glass when there is something
     behind it. There is now, so the starfield and the nebula come through the card and
     the panel stops looking like a rectangle sitting on a picture. */
  .curio__card {
    display: none;
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--r-xl);
    padding: clamp(22px, 3vw, 34px);
  }
  @supports ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .curio__card {
      background:
        linear-gradient(to bottom, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0) 34%),
        color-mix(in oklab, var(--surface) 62%, transparent);
      -webkit-backdrop-filter: var(--glass-blur);
      backdrop-filter: var(--glass-blur);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    /* The card animates in every time it is shown, and the mechanism is free: going
       from `display: none` to `display: block` makes an element newly rendered, and a
       newly rendered element starts its animations from the beginning. So pressing
       "Another one" replays this with no script and no state to track.

       One `animation` shorthand only — DESIGN.md § Motion records a section head that
       silently stopped moving because a second shorthand overwrote the first. */
    .curio__card { animation: curio-in 640ms var(--ease-out) both; }
    @keyframes curio-in {
      from { opacity: 0; transform: translate3d(0, 12px, 0) scale(0.988); }
      to   { opacity: 1; transform: none; }
    }
  }

  .curio__kind {
    margin: 0 0 16px;
    font-family: var(--font);
    font-size: 13px; font-weight: 500; letter-spacing: 0.005em;
    color: var(--ink-soft);
  }

  .curio__ask,
  .curio__quote p {
    margin: 0;
    max-width: 44ch;
    font-family: var(--font-display);
    font-size: clamp(20px, 2.5vw, 28px);
    font-weight: 400; letter-spacing: var(--track-tight); line-height: 1.2;
    text-wrap: pretty;
  }
  .curio__quote { margin: 0; border: 0; padding: 0; }
  .curio__quote footer {
    margin-top: 12px;
    font-size: 15px; font-weight: 500; color: var(--ink-soft);
  }

  .curio__reveal { margin-top: 18px; }
  /* `display: inline-block` drops the native disclosure triangle, so the control loses the
     one cue that says it opens. This puts a marker back and turns it when open. */
  .curio__reveal summary {
    display: inline-flex; align-items: center; gap: 8px;
    cursor: pointer;
    font-size: 15px; font-weight: 700;
    color: var(--accent);
    padding: 4px 0;
    list-style: none;
  }
  /* "Show me" measured 32px on a phone, under the 44px floor. This has to come AFTER
     the rule above: the first attempt was written before it and lost to that rule's
     `padding: 4px 0` — equal specificity, so source order decided it and the fix
     silently did nothing. Padding rather than min-height, because a <summary> lays out
     around its disclosure marker and a min-height would strand the marker at the top
     of the taller box. */
  @media (pointer: coarse) {
    .curio__reveal summary { padding-block: 11px; }
  }
  .curio__reveal summary::-webkit-details-marker { display: none; }
  .curio__reveal summary::before {
    content: '';
    width: 0; height: 0;
    border-left: 6px solid currentColor;
    border-top: 4px solid transparent;
    border-bottom: 4px solid transparent;
  }
  .curio__reveal[open] summary::before { transform: rotate(90deg); }
  @media (prefers-reduced-motion: no-preference) {
    .curio__reveal summary::before { transition: transform 150ms cubic-bezier(.2,.7,.3,1); }
  }
  .curio__reveal summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .curio__reveal p {
    margin: 10px 0 0;
    max-width: 66ch;
    color: var(--ink-soft);
    line-height: 1.6;
  }

  .curio__source {
    margin: 20px 0 0;
    font-size: 13px; color: var(--ink-soft);
  }
  .curio__source a { color: inherit; text-decoration-color: var(--hairline); }

  .curio__foot {
    margin-top: 20px;
    display: flex; align-items: center; justify-content: space-between;
    gap: 16px; flex-wrap: wrap;
  }
  .curio__next {
    display: inline-block;
    cursor: pointer;
    font-size: 15px; font-weight: 700;
    padding: 10px 16px;
    border: 1px solid var(--hairline);
    border-radius: var(--r-md);
    background: var(--ground);
  }
  .curio__next:hover { border-color: var(--accent); }
  .curio__count { margin: 0; font-size: 13px; color: var(--ink-soft); }

  /* This started as a row of dots, one per card, which works for a short deck and stops
     working the moment it is not one: at twenty-one entries the row is 924px of targets,
     wrapping into three rows of mostly nothing on a laptop. Two moves and a counter say
     the same thing in a fixed amount of space, however long the deck gets. */
  .curio__moves { display: flex; gap: 10px; flex-wrap: wrap; }
  .curio__back {
    display: inline-flex; align-items: center; gap: 8px;
    min-height: 44px;
    padding: 0 14px;
    cursor: pointer;
    font-size: 15px; font-weight: 600;
    color: var(--ink-soft);
    border: 1px solid transparent;
    border-radius: var(--r-md);
  }
  .curio__back:hover { color: var(--ink); border-color: var(--hairline); }
</style>
