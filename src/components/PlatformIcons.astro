---
interface Props { platforms: string[]; }
const { platforms } = Astro.props;
const labels: Record<string, string> = {
  android: 'Android', ios: 'iPhone', web: 'Web browser',
  macos: 'macOS', windows: 'Windows',
};
---
<ul class="plats" aria-label="Available on">
  {platforms.map((p) => (
    <li>
      <span class="plats__dot" aria-hidden="true"></span>
      {labels[p] ?? p}
    </li>
  ))}
</ul>

<style>
  .plats {
    display: flex; flex-wrap: wrap; gap: 4px 14px;
    list-style: none; margin: 0; padding: 0;
    font-size: 13px; font-weight: 500; color: var(--ink-soft);
  }
  .plats li { display: inline-flex; align-items: center; gap: 6px; }
  .plats__dot {
    width: 5px; height: 5px; border-radius: 50%;
    background: currentColor; opacity: .55;
  }
</style>
