---
import Preview from './Preview.astro';
import PlatformIcons from './PlatformIcons.astro';

interface Props { app: any; }
const { app } = Astro.props;
const d = app.data;
---
<article class="card reveal">
  <a class="card__link" href={`/apps/${d.slug}/`}>
    {/* One line of metadata instead of a row of pills. Three rounded badges above every
        card is component-library furniture; a single written line reads as a catalogue
        entry, which is what the card is. Set like .label — text face, sentence case —
        because uppercase mono at 11px is the tell this site had everywhere. */}
    <span class="card__meta">
      {d.category} · {d.status === 'beta' ? 'Beta' : 'Live'} · Free
    </span>

    <Preview name={d.name} icon={d.icon} card={d.card} />

    <h3 class="card__name">
      {d.name}
      {d.nativeName && <span class="card__native">{d.nativeName}</span>}
    </h3>
    <p class="card__tagline">{d.tagline}</p>
    {d.audience && <p class="card__audience">{d.audience}</p>}
    <PlatformIcons platforms={d.platforms} />
  </a>
</article>

<style>
  .card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--r-md);
    transition: border-color 150ms var(--ease), transform 150ms var(--ease);
  }
  .card__link {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 14px;
    text-decoration: none;
    color: inherit;
    height: 100%;
  }
  .card__meta {
    font-family: var(--font);
    font-size: 12.5px;
    font-weight: 500;
    letter-spacing: 0.005em;
    color: var(--ink-soft);
  }
  .card__name {
    margin: 2px 0 0;
    font-family: var(--font-display);
    font-size: 23px; font-weight: 400; letter-spacing: var(--track-tight); line-height: 1.14;
    display: flex; align-items: baseline; gap: 9px; flex-wrap: wrap;
  }
  .card__native { font-size: 13px; font-weight: 500; color: var(--ink-soft); font-family: var(--font); }
  .card__tagline { margin: 0; color: var(--ink-soft); font-size: 15px; line-height: 1.45; }
  /* Who it is for, on the grid. A stranger scanning the homepage has nothing else to go
     on, so the card answers "is this for me?" before they decide whether to click. It is
     set smaller and quieter than the tagline so it reads as a qualifier, not a second
     sentence competing with the first. `margin-top: auto` pushes it and the platform
     icons to the foot, which keeps the cards' baselines aligned across a row. */
  .card__audience {
    margin: auto 0 0;
    padding-top: 2px;
    color: var(--ink-soft);
    font-size: 13px; line-height: 1.4;
  }

  /* On a dark ground a card cannot be lifted with a shadow — black on black is nothing.
     What reads instead is the edge catching light, so hover raises the border to the
     accent and spills a little of it outside the box. Keep the spill low: at a higher
     alpha every card in the grid looks selected at once as the pointer crosses them. */
  .card:hover {
    /* Mixed down rather than full strength. A card is a large object and a whole
       perimeter of pure --accent around one reads as selected, not as hovered — it also
       spends the page's one accent colour on something the pointer is merely passing
       over. Focus keeps the full accent, because that one IS a state. */
    border-color: color-mix(in srgb, var(--accent) 55%, var(--rule));
    box-shadow: 0 10px 34px -16px var(--glow);
  }
  @media (prefers-reduced-motion: no-preference) {
    .card:hover { transform: translateY(-2px); }
  }
  .card:focus-within { border-color: var(--accent); }
</style>
