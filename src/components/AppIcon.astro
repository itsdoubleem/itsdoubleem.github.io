---
/* An app's own icon, the file named by `icon:` in apps/<slug>.md. Every place that draws
   one goes through here, so the shape is decided once: the launcher's rounded square,
   which is how a phone shows it and how a stranger recognises it as an app.

   Icons arrive in two forms and both come out the same. LOGGER's is a full-bleed square;
   HANGIL's is already rounded, with transparent corners. Clipping both to one radius
   makes the first match the second and leaves the second as it was.

   alt is empty by default because the name is always printed beside it — a screen
   reader would otherwise say the name twice. The build checks that the file is a square
   PNG big enough for the largest place it is drawn; see src/content.config.ts. */
import { pngSize } from '../release';

type Props = Base & ({ small?: undefined; sizes?: string } | { small: string; sizes: string });
interface Base {
  src: string;
  /** Any CSS length. `em` sizes it to the text it sits in. */
  size: string;
  alt?: string;
  class?: string;
  /** "lazy" where the icon may start below the fold, as in a grid of cards. */
  loading?: 'eager' | 'lazy';
}
/* `small` is a smaller copy of the same icon — the app's own 192px one, from its web
   build's manifest — so a 60px heading does not fetch a 512px file. It needs `sizes`,
   the largest width it is drawn at, in px (`size` may be in em, which `sizes` reads
   against the root font, not the heading's). Without it a browser assumes the full
   viewport width and always fetches the large file, so the pair is required together:
   in the type, and at build time too, since nothing here runs a type checker. */
const { src, size, alt = '', class: className, loading, small, sizes } = Astro.props;
if (small && !sizes) throw new Error(`AppIcon: small=${small} needs sizes, or the browser fetches ${src}`);
// The file's real pixels, so width/height and the srcset widths tell the truth about an
// icon of any accepted size. The build has already refused anything that is not a
// square PNG.
const px = pngSize(src)?.width ?? 512;
const smallPx = small ? (pngSize(small)?.width ?? 192) : 0;
const srcset = small ? `${small} ${smallPx}w, ${src} ${px}w` : undefined;
---
<img class:list={['appicon', className]} src={src} srcset={srcset} sizes={small ? sizes : undefined}
     alt={alt} width={px} height={px}
     style={`--appicon-size: ${size}`} loading={loading} decoding="async" />

<style>
  .appicon {
    width: var(--appicon-size); height: var(--appicon-size);
    flex: none;
    border-radius: 22%;
  }
</style>
