---
/* A phone, drawn in CSS, with real screenshots of the shipping builds inside it.
 *
 * ── It is a Galaxy, and that is a content decision, not a styling one ──
 * This was drawn as an iPhone first — rounded-off corners, a dynamic-island pill. Both
 * apps on this site ship `platforms: [android, web]` and neither has an iOS build, so
 * an iPhone frame was a picture of a device you cannot run this software on. LOGGER's
 * audience is named in its own frontmatter as foreign workers in Korea, which is about
 * as Galaxy a room as exists.
 *
 * What makes the silhouette read as Samsung rather than Apple, in order of how much
 * each one carries: a centred punch-hole camera instead of a pill; squarer corners
 * (0.105 of the width, against roughly 0.14 on an iPhone); a thinner, even bezel; and
 * flat sides, which is why the rail is lit along both vertical edges rather than with
 * one soft diagonal sweep. The volume rocker and power key sit on the right, which is
 * the side Samsung puts them on.
 *
 * If a piece of work here ever does ship on iOS, this is the file to revisit — but
 * revisit it by making the frame follow the content, not by picking the prettier phone.
 *
 * ── Why the chrome is CSS and not an image ──
 * A PNG of a handset is one fixed size and one fixed pixel density, and it would have
 * to be redrawn the day the accent colour changes because its bezel reflects the page
 * it sits on. Drawn in CSS it is sharp at any DPR, it costs no request, and the rim
 * picks up --accent automatically.
 *
 * ── What is inside it is NOT drawn ──
 * The screens are `card.png` and friends: real captures of the running app, produced by
 * tools/capture-guide.mjs. DESIGN.md § The app card explains at length why a hand-built
 * HTML miniature is forbidden here — the last one said "VERIFY TO CLOCK IN" where the
 * app says "HOLD TO CLOCK IN" and omitted a whole card. Do not reintroduce one.
 *
 * ── The one measurement that makes this work ──
 * Every capture is 780 x 1688, which is exactly 2x of 390 x 844. So a screen laid out at
 * or under 390 CSS px is showing the picture at its native density or better, and never
 * upscaling it. That is the trap DESIGN.md § The app card describes, avoided by
 * construction rather than by remembering — but if you ever widen --phone-w past 390px,
 * you have walked into it.
 */
interface Screen {
  src: string;
  alt: string;
  /* The app's own `theme_color`, read from its web manifest by whoever is calling.
     This is the colour Android paints the status bar in `display: standalone`, so it is
     the real colour of the strip the camera sits in. null means unknown — and unknown
     means no strip and no camera, never a guessed one. */
  statusColor?: string | null;
}
interface Props {
  screens: Screen[];
  /* Seconds each screen holds before the crossfade. Only used when there is more than
     one — a single screen does not animate at all, because a "carousel" of one is a
     fade-out and back for no reason. */
  dwell?: number;
}
const { screens, dwell = 4.5 } = Astro.props;

/* The status bar is drawn only when EVERY screen knows its own colour. It is one strip
 * of fixed height shared by all of them, so a single unknown would leave one app's bar
 * painted in another app's colour — which is worse than having none, because it looks
 * deliberate. All or nothing. */
const hasStatus = screens.length > 0 && screens.every((s) => Boolean(s.statusColor));

const n = screens.length;
const fade = 0.9;
const total = n * dwell;

/* The crossfade is one keyframe set shared by every screen, with each screen started at
 * a different point of it by a NEGATIVE animation-delay. The alternative — a keyframe
 * set per screen — grows with the number of apps and is the sort of thing that silently
 * stops working when a third one is added.
 *
 * The percentages depend on how many screens there are, which is why this is generated
 * here rather than written in the stylesheet. Read them as: hold, fade out, stay out,
 * fade back in just as your turn comes round again.
 */
const p1 = (((dwell - fade) / total) * 100).toFixed(3);
const p2 = ((dwell / total) * 100).toFixed(3);
const p3 = (((total - fade) / total) * 100).toFixed(3);

const cycleCss = n > 1
  ? `@keyframes device-cycle {
  0%, ${p1}%   { opacity: 1; }
  ${p2}%, ${p3}% { opacity: 0; }
  100%         { opacity: 1; }
}
@media (prefers-reduced-motion: no-preference) {
  .device__screens[data-cycle] .device__screen {
    animation: device-cycle ${total}s var(--ease-wipe) infinite;
  }
}`
  : '';
---
<div class="device">
  {/* The ambient bloom. It is a sibling of the handset rather than a filter on it, so
      it never repaints while the phone tilts — a drop-shadow() on a transformed element
      is recomputed every frame, and this one is 400px across. */}
  <div class="device__bloom" aria-hidden="true"></div>

  {/* Three nested elements, one transform each: the entry, the idle float, and the
      tilt. They are separate because they run at once and would otherwise have to share
      a single `transform`, where the last rule to set it wins outright and the other two
      silently disappear. DESIGN.md § Motion records that happening once already. */}
  <div class="device__enter">
    <div class="device__float">
      <div class="device__tilt" data-tilt>
        <div class="device__shell">
          {/* Each screen is a layer, not a bare <img>: the layer carries that app's own
              status-bar colour behind the capture, so the two crossfade together and a
              white-barred app never shows for a frame with the previous app's bar. */}
          <div class="device__screens" data-cycle={n > 1 ? '' : undefined} data-status={hasStatus ? '' : undefined}>
            {screens.map((s, i) => (
              <div
                class="device__screen"
                style={`--status:${s.statusColor ?? 'transparent'}; animation-delay: calc(-1 * ${i} * ${dwell}s);`}
              >
                <img
                  class="device__shot"
                  src={s.src}
                  alt={s.alt}
                  width="390"
                  height="844"
                  decoding="async"
                  fetchpriority={i === 0 ? 'high' : 'low'}
                  loading={i === 0 ? 'eager' : 'lazy'}
                />
              </div>
            ))}
            {/* The camera and the sheen sit over the screen, never under it, and neither
                takes a pointer — the screenshot underneath is inside a link on some
                pages and a glare that swallows the click is a maddening bug to find. */}
            {hasStatus && <div class="device__punch" aria-hidden="true"></div>}
            <div class="device__glare" aria-hidden="true"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{cycleCss && <style is:inline set:html={cycleCss}></style>}

<style>
  /* --phone-w is the screen's width, and everything else on the handset is derived from
     it, so the whole device scales by changing one number. Ceiling is 390px and that is
     not a taste call — see the note at the top of this file. */
  .device {
    /* Ceiling came down from 330 when the page took publik's density: the hero grid
       centres a ~430px column of copy against this, so every pixel of phone height is
       two pixels of dead space above the headline. 290 keeps the whole hero inside a
       1000px viewport. The 390 ceiling from the note above is still the hard limit. */
    /* Indirected through --phone-size so a page can ask for a different size without
       this file knowing about that page. The element's own declaration always beats an
       inherited one, so a parent setting --phone-w directly would be ignored — the var
       fallback is what makes it overridable at all. */
    --phone-w: var(--phone-size, clamp(222px, 20.5vw, 290px));
    /* Every one of these is a fraction of --phone-w, so the whole handset scales by
       changing that one number and nothing drifts out of proportion. The fractions are
       Galaxy S-series proportions, not invented:
         --bezel     thin and even on all four sides (an iPhone frame wants ~0.031)
         --r-phone   0.105 — squarer than an iPhone, which sits nearer 0.14
         --strip-px  the black band above the capture; see the note on .device__screens
         --punch     the camera hole, centred in that band */
    --bezel:    calc(var(--phone-w) * 0.022);
    --r-phone:  calc(var(--phone-w) * 0.105);
    --strip-px: calc(var(--phone-w) * 0.09744);   /* 38 / 390 */
    --punch:    calc(var(--phone-w) * 0.052);
    position: relative;
    width: max-content;
    margin-inline: auto;
  }

  /* A wide, soft pool of mint behind the phone. This is what "ambient bloom" means on a
     ground this dark: the object is not lit from outside, it is the thing emitting. */
  .device__bloom {
    position: absolute;
    left: 50%;
    top: 46%;
    width: 168%;
    aspect-ratio: 1;
    translate: -50% -50%;
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--glow) 0%, var(--glow-soft) 44%, transparent 72%);
    opacity: .5;
    pointer-events: none;
    z-index: 0;
  }

  .device__enter,
  .device__float,
  .device__tilt { position: relative; z-index: 1; }

  /* The tilt. --tx/--ty are written by /motion.js as signed numbers from -1 to 1; the
     degrees they are worth are decided here, which is what lets the media query below
     flatten the whole effect without the script knowing anything about breakpoints.

     With no script they are simply unset and the fallbacks make this the identity
     transform, so the phone sits square and finished. The transition is the smoothing:
     pointermove fires far more often than the compositor draws, and without it the
     phone snaps between positions instead of following the cursor. */
  .device__tilt {
    --tilt: 9deg;
    transform:
      perspective(1200px)
      rotateY(calc(var(--tx, 0) * var(--tilt)))
      rotateX(calc(var(--ty, 0) * var(--tilt) * -1));
    transform-style: preserve-3d;
    will-change: transform;
    transition: transform 500ms var(--ease);
  }

  /* The handset itself.

     The rail is lit on both vertical edges rather than with a single diagonal sweep,
     and that is the difference between a flat-sided phone and a rounded one. A Galaxy's
     sides are flat planes, so each one catches the light as a hard bright line down the
     full height; a curved rail smears that into a gradient across the face. The
     diagonal layer underneath is still there, but faint — it is the glass, not the
     metal. Swap the order of the two gradients and it goes back to reading as an
     iPhone. */
  .device__shell {
    position: relative;
    padding: var(--bezel);
    border-radius: var(--r-phone);
    background:
      linear-gradient(90deg,
        rgba(255, 255, 255, 0.24) 0%, rgba(255, 255, 255, 0.02) 3.5%,
        rgba(255, 255, 255, 0) 50%,
        rgba(255, 255, 255, 0.02) 96.5%, rgba(255, 255, 255, 0.24) 100%),
      linear-gradient(168deg, rgba(255, 255, 255, 0.10) 0%, rgba(255, 255, 255, 0) 38%),
      #070E0B;
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.10),
      0 40px 80px -28px rgba(0, 0, 0, 0.9),
      0 0 60px -14px var(--glow);
  }

  /* The side keys: volume rocker above, power below it, both on the right — which is
     where Samsung puts them and the other half of what makes the silhouette read as a
     Galaxy rather than as a generic slab.

     They are pseudo-elements on the shell rather than real divs because they are pure
     decoration and must never reach the accessibility tree. They tuck slightly UNDER
     the rail (the negative margin) so they read as part of the body rather than as two
     tabs stuck on the side. They stick out of .device, which is why the hero sets
     overflow-x: clip — see the note on .hero in index.astro. */
  .device__shell::before,
  .device__shell::after {
    content: '';
    position: absolute;
    left: 100%;
    margin-left: calc(var(--phone-w) * -0.0022);
    width: calc(var(--phone-w) * 0.0085);
    border-radius: 0 40% 40% 0 / 0 6% 6% 0;
    background: linear-gradient(to right, rgba(255, 255, 255, 0.18), rgba(255, 255, 255, 0.04));
    pointer-events: none;
  }
  .device__shell::before { top: 23%;   height: 11%; }    /* volume rocker */
  .device__shell::after  { top: 36.5%; height: 6.4%; }   /* power */

  /* ── Why the screen is taller than the capture, and why the bar is not black ──
     The captures are 390 x 844 of app CONTENT. They were taken in a headless browser,
     which has no status bar, so the app starts at the very first pixel. On a real phone
     there is a bar above that content, and on a Galaxy the punch-hole camera sits in it.

     The first version of this drew that bar BLACK, which is what most device mockups do
     — and it was wrong twice over. A modern Galaxy has no notch and no black band; and
     in `display: standalone`, which is what both apps declare, Android paints the status
     bar in the app's own `theme_color`. For LOGGER that is #f3f2f2 and for HANGIL it is
     #FFFFFF, so the real thing is a white bar with a small dark dot near the top — not a
     black slot cut out of the screen.

     So the bar is --status, handed in per screen from the app's shipping manifest, and
     it is 38px: 844 + 38 = 882, the aspect ratio below. The height stays in px on
     .device (--strip-px) so the camera can be centred in it by arithmetic rather than by
     a guessed percentage. Recapture at a different height and those two change together.

     Shrinking it to nothing is not an option. The camera is centred, and at 390 wide
     that puts it directly on LOGGER's language button — a device frame may not cover the
     app's interface, which is the whole reason the bar exists. And where the colour is
     unknown there is no bar and no camera at all, rather than a black one: see
     `hasStatus` at the top of this file. */
  .device__screens {
    position: relative;
    width: var(--phone-w);
    aspect-ratio: 390 / 882;
    border-radius: calc(var(--r-phone) - var(--bezel));
    overflow: hidden;
    background: #000;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.6);
  }
  /* With no known status colour the screen is exactly the capture, edge to edge. */
  .device__screens:not([data-status]) { aspect-ratio: 390 / 844; --strip-px: 0px; }

  /* One layer per screen, each carrying its own app's status-bar colour. They are
     stacked in the same place; the first is opaque and the rest are transparent, so with
     animation off — reduced motion, or an old browser — the reader sees one screen
     rather than a pile of them. */
  .device__screen {
    position: absolute;
    inset: 0;
    background: var(--status);
    opacity: 0;
  }
  .device__screen:first-child { opacity: 1; }

  .device__shot {
    position: absolute;
    top: var(--strip-px);
    left: 0;
    right: 0;
    width: 100%;
    height: auto;
    object-fit: cover;
    object-position: top;
  }

  /* The punch-hole camera: a small dark circle, centred horizontally, centred in the
     status bar vertically. It replaced a dynamic-island pill, which was the single most
     Apple-shaped thing on the page.

     It is dark ON A LIGHT BAR here, which is the right way round and the opposite of
     what a notch looks like. The vertical centring is arithmetic — (strip - punch) / 2 —
     which is why --strip-px is carried in pixels rather than as a percentage of the
     882-tall screen. */
  .device__punch {
    position: absolute;
    top: calc((var(--strip-px) - var(--punch)) / 2);
    left: 50%;
    translate: -50% 0;
    width: var(--punch);
    height: var(--punch);
    border-radius: 50%;
    background: radial-gradient(circle at 38% 32%, #2b2f2d 0%, #080a09 58%);
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.18);
    pointer-events: none;
  }

  /* The reflection. A single band of light across the glass at a shallow angle. It is
     deliberately faint: the screenshots underneath are captures of a LIGHT app, and a
     strong sheen over them stops reading as glass and starts reading as a washed-out
     image — which would be showing the reader something other than what they will get. */
  .device__glare {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      162deg,
      rgba(255, 255, 255, 0.14) 0%,
      rgba(255, 255, 255, 0.05) 16%,
      rgba(255, 255, 255, 0) 38%
    );
    mix-blend-mode: screen;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Entry. Scale and lift, on the spring — the phone arrives rather than stops.
       `both` holds the from-state before it starts; without it the device flashes at
       full size for one frame on a slow first paint. */
    .device__enter { animation: device-enter 1100ms var(--spring) both; animation-delay: 180ms; }
    @keyframes device-enter {
      from { opacity: 0; transform: scale(0.95) translate3d(0, 26px, 0); }
      to   { opacity: 1; transform: none; }
    }

    /* Idle. Six pixels either side of rest, over seven seconds. Slow enough that you
       notice it only when you are not looking at it, which is the point. translate3d
       rather than translateY so it stays on the compositor. */
    .device__float { animation: device-float var(--float) ease-in-out infinite; }
    @keyframes device-float {
      0%, 100% { transform: translate3d(0, -6px, 0); }
      50%      { transform: translate3d(0,  6px, 0); }
    }
  }

  /* Below the layout's two-column breakpoint the phone is centred above the copy and
     the 3D goes away. A tilt needs a cursor to answer, and on a touch screen there is
     none — a permanently skewed phone is just a crooked phone. */
  @media (max-width: 899px) {
    .device { --phone-w: clamp(210px, 52vw, 286px); }
    .device__tilt { --tilt: 0deg; transform: none; }
  }
</style>
