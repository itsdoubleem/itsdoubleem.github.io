---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const year = new Date().getFullYear();
// "/#work" rather than "/" — from the homepage a bare "/" reloads the page and appears
// to do nothing, which is exactly what it looked like.
const nav = [
  { href: '/#work', label: 'Work' },
  { href: '/about/', label: 'About' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    {/*
      The site ships zero script tags, so the policy that matches it is "no scripts at
      all" — default-src 'none' with nothing granting script-src. That is not belt and
      braces: markdown in /apps is rendered with <Content />, and Astro passes raw HTML
      in a markdown body straight through to the page. A <script> in an app file would
      run. Built and checked: it does. With this header it does not, and the claim on
      the about page stays true even if a bad file lands.

      Keep it first in <head>: a meta CSP governs only what the parser sees after it.

      What each grant is for, so nothing gets widened by guesswork:
        img-src   'self' data:      favicon, screenshots, and inline SVG data URIs
        style-src 'self' 'unsafe-inline'
                                    build.inlineStylesheets is 'always', and the curio
                                    deck injects rules with is:inline — both are inline
                                    styles, so this cannot be tightened without changing
                                    how the site is built
        font-src  'self'            the two Figtree woff2 files, self-hosted
        base-uri / form-action 'none'
                                    there is no <base> and no <form> on the site; these
                                    stop an injected one from retargeting a link or
                                    posting somewhere

      Links out (tally.so, github.com, the curio sources) are navigations, which CSP does
      not govern — they keep working.

      What this canNOT do: frame-ancestors is ignored in a meta tag, and GitHub Pages
      cannot send real headers, so the site stays framable. See the security notes.
    */}
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; base-uri 'none'; form-action 'none'"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* Both faces are preloaded because both are above the fold on every page: the
        serif sets the headline, Figtree sets the line under it. The mono role uses
        whatever the OS already has, so it costs nothing to preload and nothing to
        download. */}
    <link rel="preload" href="/fonts/instrument-serif-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/figtree-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <header class="site-head">
      <div class="wrap site-head__inner">
        <a href="/" class="wordmark" aria-label="DOUBLEEM, home">
          DOUBLEEM<span aria-hidden="true">.</span>
        </a>
        <nav aria-label="Main">
          {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap site-foot__inner">
        <p class="site-foot__mark">DOUBLEEM<span aria-hidden="true">.</span></p>
        <p class="site-foot__line">
          One person, making things and putting them where people can find them.
          This site collects nothing about you.
        </p>
        <p class="site-foot__meta">&copy; {year} DOUBLEEM</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-head {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--ground);
    border-bottom: 1px solid var(--hairline);
  }
  .site-head__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 62px;
  }
  /* The wordmark is set in the display serif at a size that sits quietly beside the
     nav rather than announcing itself. Its full stop used to be accent-coloured — one
     of five accent things on the old homepage, and the least useful of them, since a
     decorative dot cannot be clicked. */
  .wordmark {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 23px;
    letter-spacing: 0.01em;
    text-decoration: none;
  }

  .site-head nav { display: flex; gap: 4px; }
  .site-head nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 12px;
    border-radius: var(--r-sm);
    font-size: 15px;
    font-weight: 500;
    color: var(--ink-soft);
    text-decoration: none;
  }
  .site-head nav a:hover { color: var(--ink); }
  .site-head nav a[aria-current="page"] { color: var(--ink); }

  .site-foot {
    margin-top: 96px;
    background: var(--panel);
    color: #fff;
  }
  .site-foot__inner { padding-block: 48px; }
  .site-foot__mark {
    margin: 0 0 12px;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 27px;
    letter-spacing: 0.01em;
  }
  .site-foot__line {
    margin: 0 0 24px;
    max-width: 42ch;
    color: rgba(255, 255, 255, 0.72);
  }
  .site-foot__meta {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.06em;
    color: rgba(255, 255, 255, 0.45);
  }
</style>
