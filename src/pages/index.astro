---
/* The front page. A hero, three facts, and one door.
 *
 * ── Why there is no work on it ──
 * This page used to carry everything: hero, the featured work, the grid, the screenshot
 * showcase, the facts and the curio deck — five sections and about 4,800px. publik's
 * arrangement is the one this site wanted and it is the opposite shape: the front page
 * says what the place is and offers one way in, and everything made lives one click
 * behind that, at /apps/.
 *
 * It is now the hero and the footer, which is publik's front page exactly. It held
 * three glass tiles under the hero for a while — "No account", "Nothing collected",
 * "Nothing to install" — and they were removed on 2026-09-20 at the owner's request.
 *
 * Nothing was lost with them, which is why they went without a fight: all three were
 * restatements of the about page, where the same facts are set out at length and in
 * context ("What this site collects" — nothing, no cookies, no analytics, no
 * third-party scripts), and the third was a summary of what every app page already
 * says in its platform notes. A front page that repeats another page's argument in
 * larger type is not answering a question, it is filling space.
 *
 * So the hero answers "what is this" and hands the reader one door. The other two
 * questions CLAUDE.md says the site exists to answer — what this person makes, and
 * whether to trust it — are answered by the pages behind that door and by /about,
 * which is the second link in the nav.
 *
 * Nothing on this page names an app. The phone's screens and the platform line are both
 * derived from the collection, so adding a piece of work is still adding one file.
 */
import { getCollection } from 'astro:content';
import { themeColor } from '../theme-color';
import Base from '../layouts/Base.astro';
import PhoneDevice from '../components/PhoneDevice.astro';
import OneTrueThing from '../components/OneTrueThing.astro';

const allApps = await getCollection('apps');
const apps = allApps.sort((a, b) => a.data.order - b.data.order);

// ── What goes on the phone in the hero ──
// One screen per piece of work, in the order the catalogue lists them, taken from each
// app's `card` — which is a capture of the running build, produced by
// tools/capture-guide.mjs. An app with no capture is skipped rather than represented by
// a placeholder: a blank slot in a hero device would be the first thing a visitor sees
// and the last thing they trust.
//
// The status-bar colour comes from each app's own web manifest — see src/theme-color.ts
// for why it is read from there rather than typed into frontmatter.
const heroScreens = apps
  .filter((a) => a.data.card)
  .map((a) => ({
    src: a.data.card as string,
    alt: `${a.data.name} running on a phone`,
    statusColor: themeColor(a.data.slug),
  }));

// ── The pill above the headline ──
// It says one true, checkable thing about what is on this site today, and it is built
// from the content rather than typed, so it cannot go stale. Every platform every piece
// of work runs on, de-duplicated.
//
// Do NOT turn this into a figure. CLAUDE.md hard rule 1, and DESIGN.md names the
// reference's `>90% system performance` pill row as the specific thing not to copy.
const PLATFORM_WORDS: Record<string, string> = {
  android: 'Android', ios: 'iPhone', web: 'the browser', macos: 'macOS', windows: 'Windows',
};
const platforms = [...new Set(apps.flatMap((a) => a.data.platforms))].map((p) => PLATFORM_WORDS[p] ?? p);
const platformLine =
  platforms.length > 1
    ? `${platforms.slice(0, -1).join(', ')} and ${platforms.at(-1)}`
    : platforms[0];

---
<Base
  title="doubleem — everything I make ends up here"
  description="One person's work: apps and tools mostly, and whatever else turns out to be worth sharing."
>
  {/* The hero is two columns: the words on the left, the work on the right.

      It used to be one column of text on an empty page. That was a deliberate reaction
      against the template hero — uppercase accent kicker, 104px extra-bold headline with
      a coloured full stop, filled button beside a ghost link — and the reaction was
      right, but it left a studio site that showed none of the studio's work above the
      fold. What is on the right is not an illustration and not a mock-up: it is the
      actual screen of the actual app, cycling through everything in the catalogue.

      `data-tilt-area` is the region /motion.js tracks the pointer across. It is the
      whole hero rather than the phone itself, so the device answers the cursor crossing
      the section instead of only the cursor landing on top of it. With no script, no
      pointer, or reduced motion, none of this runs and the phone sits square. */}
  <section class="hero" data-tilt-area>
    <div class="hero__inner wrap">
      <div class="hero__copy">
        <p class="pill enter enter--1">
          <span class="pill__dot" aria-hidden="true"></span>
          Runs on {platformLine}
        </p>

        {/* Split into lines by hand, in the markup, so nothing has to re-lay out on
            load. Each line rises out from behind the one above it — see .split in
            global.css. Keep the break where it is: "Everything I make" is the claim and
            "ends up here" is the payoff, and splitting them anywhere else loses that. */}
        <h1 class="display display--hero split">
          <span class="split__c"><span class="split__l">Everything I make</span></span>
          <span class="split__c"><span class="split__l">ends up here.</span></span>
        </h1>

        <p class="lead enter enter--3">
          Apps, tools, and whatever else I end up making — each with a page that says
          plainly what it does and what it doesn't.
        </p>
        {/* The one door, and the whole job of this page. It is the only filled control
            on it, and it goes to the catalogue.

            The second control pointed at /about/ and read "What this is". That was right
            when the front page was only a hero — the note here used to end "because there
            is nothing further down", and there wasn't. Both halves of that are now false:
            there is a 42-chapter deck below, and the nav already carries an About button
            two inches up, so the link was spending the page's one secondary control on a
            destination the reader could already reach.

            It names its destination rather than teasing it: the text is the section's own
            heading, so nothing about the arrival is a surprise. The arrow points down
            because the link moves you down this page instead of leaving it, and
            .textlink--down turns the hover slide to match — see global.css. */}
        <div class="hero__actions enter enter--4">
          <a class="btn btn--primary" href="/apps/">See the work</a>
          <a class="textlink textlink--down" href="#how-we-got-here">
            How we got here <span aria-hidden="true">↓</span>
          </a>
        </div>
      </div>

      {heroScreens.length > 0 && (
        <div class="hero__device">
          <PhoneDevice screens={heroScreens} />
        </div>
      )}
    </div>
  </section>

  {/* The curio deck lives here and only here.

      It has moved twice. It was on the homepage, then went to the foot of /apps/ on the
      reasoning that it is a reward for scrolling and belongs where somebody interested
      ends up — then came back, because the catalogue is a page about the work and a
      deck of science facts on the end of it is a non sequitur however well it reads.
      The front page is where an aside belongs: it is the one page that is not about
      anything in particular, and the deck is the only thing on this site with no job
      to do. Do not add it to a third page; an aside that appears everywhere is
      furniture. */}
  <OneTrueThing />

</Base>

<style>
  /* ---------- hero ---------- */
  .hero {
    /* The header floats over the page and no longer pushes anything down, so the hero
       has to clear it itself. --head-h is the bar plus its inset; the clamp on top of
       it is the breathing room. Get this wrong and the headline slides under the nav —
       see the note on --head-h in global.css. */
    /* The bottom padding is small because the deck follows and brings its own top
       margin. It was clamp(48px, 7vw, 92px) while the hero WAS the whole page and the
       footer sat directly under it; leaving it at that stacked the two and opened a
       170px hole between the phone and the deck. */
    padding-block: calc(var(--head-h) + clamp(8px, 1.6vw, 22px)) clamp(16px, 2.5vw, 34px);
    /* The device's ambient bloom is 168% of the phone's width and centred on it, so at
       any viewport between about 880px and 1400px it reaches past the right edge of the
       page and adds a horizontal scrollbar to the whole document. Measured: 1092px of
       scrollWidth in a 1024px window.

       `clip` and not `hidden`: hidden would make this a scroll container, which changes
       how anything inside it anchors. clip just stops the paint at the hero's own edges,
       and the hero is full-bleed, so the bloom is still allowed to reach the window edge
       — it simply cannot push past it. */
    overflow-x: clip;
  }
  .hero__inner { display: grid; gap: clamp(44px, 6vw, 64px); align-items: center; }
  /* 900px is the same number PhoneDevice.astro flattens its tilt at. If you move one,
     move the other — a phone tilting inside a stacked, centred column looks broken in a
     way that is hard to attribute to a breakpoint. */
  @media (min-width: 900px) {
    .hero__inner { grid-template-columns: minmax(0, 1fr) auto; column-gap: clamp(40px, 5vw, 76px); }
  }
  /* The measure belongs on each element, never on the block that holds them. Capping
     .hero__copy capped the paragraph too, and a 46ch lead inside a 17ch parent wraps
     into seven two-word lines that look like a mistake — because they are one. */
  .hero__copy { max-width: none; }
  .hero__copy .display--hero { max-width: 13ch; margin-top: 22px; }
  .hero .lead { margin-top: 26px; max-width: 44ch; }
  .hero__actions {
    margin-top: 32px;
    display: flex; align-items: center; flex-wrap: wrap; gap: 14px 26px;
  }
  .hero__device { justify-self: center; }

</style>
