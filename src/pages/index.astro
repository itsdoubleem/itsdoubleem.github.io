---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import AppCard from '../components/AppCard.astro';
import Preview from '../components/Preview.astro';
import PlatformIcons from '../components/PlatformIcons.astro';
import OneTrueThing from '../components/OneTrueThing.astro';

const [allApps, guides] = await Promise.all([getCollection('apps'), getCollection('guides')]);
const apps = allApps.sort((a, b) => a.data.order - b.data.order);
const count = apps.length;

// The lowest-ordered work gets a spread of its own, and the rest fall into the grid
// underneath, grouped by kind. This is not decoration: a three-column grid holding one
// card is the most obvious tell that a page was laid out by a template and never looked
// at. A single work now fills the width on purpose, and the grid appears when there is
// something to put in it.
const [feature, ...rest] = apps;
const featureGuide = feature && guides.some((g) => g.data.app === feature.data.slug);

const GROUPS: Array<[string, string]> = [
  ['app', 'Apps'],
  ['tool', 'Tools'],
  ['writing', 'Writing'],
  ['novel', 'Novels'],
  ['bot', 'Bots'],
  ['other', 'Other'],
];
// A group is rendered only when something is in it — an empty "Novels" heading would
// advertise work that does not exist, which is hard rule 1 wearing a different hat.
const grouped = GROUPS
  .map(([key, label]) => [label, rest.filter((a) => a.data.type === key)] as const)
  .filter(([, items]) => items.length > 0);

// Three things that are true of everything here, used as the hero's right-hand column and
// again as the band lower down. Not slogans — each one is a checkable property of the
// site, which is why they can sit this large without embarrassing anybody.
const stance = [
  { k: 'Free', v: 'Every app here is free and stays free. No tiers, no upgrade screen, no trial running out.' },
  { k: 'No account', v: 'Nothing asks you to sign up, because there is nothing to sign up to.' },
  { k: 'Nothing collected', v: 'No cookies, no analytics, not one script on the page. That is why you were never shown a banner.' },
];
---
<Base
  title="DOUBLEEM — everything I make ends up here"
  description="One person's work: apps and tools mostly, and whatever else turns out to be worth sharing."
>
  {/* The hero is full-bleed rather than an inset rounded panel, and the type is the
      picture. It used to carry an abstract SVG of stacked cards, which read as the
      placeholder art it was. A screenshot cannot go here either — that would make the
      whole site look like it is about one app — so the headline does the work instead. */}
  <section class="hero">
    <div class="hero__inner wrap">
      <div class="hero__copy">
        <p class="hero__eyebrow">One person's work</p>
        <h1 class="hero__title">
          Everything I make ends up here<span class="hero__dot">.</span>
        </h1>
        <p class="hero__sub">
          Apps, tools, and whatever else I end up making — each with a page that says
          plainly what it does and what it doesn't.
        </p>
        <div class="hero__actions">
          <a class="btn btn--primary" href="#work">See the work</a>
          <a class="hero__link" href="/about/">What this is <span aria-hidden="true">→</span></a>
        </div>
      </div>

      <ul class="stance">
        {stance.map((s) => (
          <li class="stance__row">
            <p class="stance__k">{s.k}</p>
            <p class="stance__v">{s.v}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="work wrap" id="work">
    <header class="sec">
      <p class="sec__num">01</p>
      <div class="sec__text">
        <h2 class="sec__title">The work</h2>
        <p class="sec__note">
          {count === 1
            ? 'One so far. Things get listed here when they work, not when they are announced.'
            : 'Everything here is finished enough to use. Things get listed when they work, not when they are announced.'}
        </p>
      </div>
    </header>

    {feature && (
      <article class="feature">
        <a class="feature__shot" href={`/apps/${feature.data.slug}/`} tabindex="-1" aria-hidden="true">
          <Preview name={feature.data.name} icon={feature.data.icon} card={feature.data.card} />
        </a>

        <div class="feature__body">
          <div class="feature__badges">
            <span class="badge">{feature.data.category}</span>
            {feature.data.status === 'beta' && <span class="badge">Beta</span>}
            <span class="badge badge--free">Free</span>
          </div>

          <h3 class="feature__name">
            <a href={`/apps/${feature.data.slug}/`}>{feature.data.name}</a>
            {feature.data.nativeName && (
              <span class="feature__native">{feature.data.nativeName}</span>
            )}
          </h3>

          <p class="feature__tagline">{feature.data.tagline}</p>
          <PlatformIcons platforms={feature.data.platforms} />

          <div class="feature__links">
            <a class="btn btn--primary" href={`/apps/${feature.data.slug}/`}>
              Open {feature.data.name}
            </a>
            {featureGuide && (
              <a class="hero__link hero__link--ink" href={`/apps/${feature.data.slug}/guide/`}>
                See how it works <span aria-hidden="true">→</span>
              </a>
            )}
          </div>
        </div>
      </article>
    )}

    {grouped.map(([label, items]) => (
      <section class="group">
        <h3 class="group__head">
          {label}
          <span class="group__count">{items.length}</span>
        </h3>
        <div class="grid" data-count={Math.min(items.length, 3)}>
          {items.map((app) => <AppCard app={app} />)}
        </div>
      </section>
    ))}
  </section>

  {/* The same three statements as the hero, given room. It breaks a long light page with
      a dark band, which is the rhythm the design notes describe, and it puts the site's
      position where somebody scrolling past the work will actually meet it. */}
  <section class="band">
    <div class="band__inner wrap">
      <p class="band__lead">What is true of everything on this site</p>
      <ul class="band__list">
        {stance.map((s) => (
          <li>
            <p class="band__k">{s.k}</p>
            <p class="band__v">{s.v}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <OneTrueThing />
</Base>

<style>
  /* ---------- hero ---------- */
  /* <main> is unstyled and full-width, so a section is already edge to edge and the inner
     .wrap does the centring. Deliberately not the `margin-inline: calc(50% - 50vw)` trick:
     100vw counts the scrollbar, so on any desktop that shows one it hands the page a few
     pixels of horizontal scroll. */
  .hero {
    background: var(--panel);
    color: #fff;
    padding-block: clamp(52px, 9vw, 104px);
  }
  .hero__inner {
    display: grid;
    gap: clamp(36px, 5vw, 64px);
    align-items: end;
  }
  @media (min-width: 900px) {
    .hero__inner { grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.85fr); }
  }

  .hero__eyebrow {
    margin: 0 0 18px;
    font-size: 13px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--accent);
  }
  .hero__title {
    margin: 0;
    max-width: 15ch;
    font-size: clamp(40px, 6.4vw, 76px);
    font-weight: 800; letter-spacing: -0.045em; line-height: 0.95;
    /* Let the browser even out the lines. A hand-placed <br> here stranded the word
       "make" alone on the middle line at 1440px, because the line above it had already
       wrapped on its own. Balancing beats guessing at one viewport width. */
    text-wrap: balance;
  }
  /* The wordmark's accent dot, borrowed as the full stop. */
  .hero__dot { color: var(--accent); }

  .hero__sub {
    margin: 22px 0 0;
    max-width: 44ch;
    font-size: clamp(16px, 1.6vw, 19px);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.72);
  }
  .hero__actions {
    margin-top: 30px;
    display: flex; align-items: center; flex-wrap: wrap; gap: 12px 22px;
  }
  .hero__link {
    display: inline-flex; align-items: center; gap: 8px;
    min-height: 44px;
    font-weight: 600;
    color: #fff;
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.3);
  }
  .hero__link:hover { border-bottom-color: var(--accent); }
  .hero__link--ink { color: var(--ink); border-bottom-color: var(--hairline); }

  /* Three facts, set as a ruled list. This column used to hold a drawing of cards that
     stood for nothing; a list of things that are true of the site earns the space. */
  .stance { list-style: none; margin: 0; padding: 0; }
  .stance__row {
    padding: 16px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
  }
  .stance__row:last-child { border-bottom: 1px solid rgba(255, 255, 255, 0.16); }
  .stance__k {
    margin: 0;
    font-size: 15px; font-weight: 700; letter-spacing: -0.01em;
    color: var(--accent);
  }
  .stance__v {
    margin: 4px 0 0;
    font-size: 14px; line-height: 1.55;
    color: rgba(255, 255, 255, 0.66);
  }

  .work { margin-top: clamp(56px, 9vw, 96px); }

  /* ---------- the featured work ---------- */
  .feature {
    margin-top: clamp(28px, 4vw, 44px);
    display: grid;
    gap: clamp(24px, 4vw, 48px);
    align-items: center;
  }
  @media (min-width: 760px) {
    .feature { grid-template-columns: minmax(0, 340px) minmax(0, 1fr); }
  }
  .feature__shot {
    display: block;
    padding: 8px;
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--r-lg);
    max-width: 340px;
  }
  .feature__badges { display: flex; flex-wrap: wrap; gap: 6px; }
  .feature__name {
    margin: 16px 0 0;
    font-size: clamp(30px, 4.6vw, 48px);
    font-weight: 800; letter-spacing: -0.035em; line-height: 1;
    display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap;
  }
  .feature__name a { color: inherit; text-decoration: none; }
  .feature__name a:hover { color: var(--accent-text); }
  .feature__native {
    font-size: clamp(15px, 1.6vw, 20px); font-weight: 600; color: var(--ink-soft);
  }
  .feature__tagline {
    margin: 14px 0 18px;
    max-width: 42ch;
    font-size: clamp(17px, 1.8vw, 21px);
    line-height: 1.45;
    color: var(--ink-soft);
  }
  .feature__links {
    margin-top: 24px;
    display: flex; align-items: center; flex-wrap: wrap; gap: 12px 22px;
  }

  /* ---------- the grid, for everything after the first ---------- */
  .group { margin-top: clamp(40px, 6vw, 64px); }
  .group__head {
    display: flex; align-items: center; gap: 10px;
    margin: 0 0 18px;
    font-size: 13px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--ink-soft);
  }
  .group__count { font-weight: 500; }
  .grid {
    display: grid;
    gap: var(--gap);
    grid-template-columns: 1fr;
  }
  @media (min-width: 620px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .grid { grid-template-columns: repeat(3, 1fr); } }

  /* ---------- the dark band ---------- */
  .band {
    margin-block: clamp(64px, 10vw, 112px) 0;
    background: var(--panel);
    color: #fff;
    padding-block: clamp(48px, 7vw, 80px);
  }
  .band__lead {
    margin: 0 0 28px;
    font-size: 13px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--accent);
  }
  .band__list {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: clamp(24px, 3vw, 40px);
  }
  @media (min-width: 760px) { .band__list { grid-template-columns: repeat(3, 1fr); } }
  .band__list li { border-top: 1px solid rgba(255, 255, 255, 0.2); padding-top: 18px; }
  .band__k {
    margin: 0;
    font-size: clamp(20px, 2.4vw, 26px);
    font-weight: 800; letter-spacing: -0.02em;
  }
  .band__v {
    margin: 10px 0 0;
    font-size: 15px; line-height: 1.6;
    color: rgba(255, 255, 255, 0.68);
  }
</style>
