---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import AppCard from '../components/AppCard.astro';
import Preview from '../components/Preview.astro';
import PlatformIcons from '../components/PlatformIcons.astro';
import OneTrueThing from '../components/OneTrueThing.astro';

const [allApps, guides] = await Promise.all([getCollection('apps'), getCollection('guides')]);
const apps = allApps.sort((a, b) => a.data.order - b.data.order);
const count = apps.length;

// The lowest-ordered work gets a spread of its own, and the rest fall into the grid
// underneath, grouped by kind. This is not decoration: a three-column grid holding one
// card is the most obvious tell that a page was laid out by a template and never looked
// at. A single work now fills the width on purpose, and the grid appears when there is
// something to put in it.
const [feature, ...rest] = apps;
const featureGuide = feature && guides.some((g) => g.data.app === feature.data.slug);

const GROUPS: Array<[string, string]> = [
  ['app', 'Apps'],
  ['tool', 'Tools'],
  ['writing', 'Writing'],
  ['novel', 'Novels'],
  ['bot', 'Bots'],
  ['other', 'Other'],
];
// A group is rendered only when something is in it — an empty "Novels" heading would
// advertise work that does not exist, which is hard rule 1 wearing a different hat.
const grouped = GROUPS
  .map(([key, label]) => [label, rest.filter((a) => a.data.type === key)] as const)
  .filter(([, items]) => items.length > 0);

// Three things that are true of everything here. Not slogans — each one is a checkable
// property of the site, which is why they can sit this large without embarrassing anybody.
const stance = [
  { k: 'Free', v: 'Every app here is free and stays free. No tiers, no upgrade screen, no trial running out.' },
  { k: 'No account', v: 'Nothing asks you to sign up, because there is nothing to sign up to.' },
  { k: 'Nothing collected', v: 'No cookies, no analytics, not one script on the page. That is why you were never shown a banner.' },
];
---
<Base
  title="DOUBLEEM — everything I make ends up here"
  description="One person's work: apps and tools mostly, and whatever else turns out to be worth sharing."
>
  {/* The hero sits on the paper, not in a dark panel.

      It used to be an inverted full-bleed block carrying an uppercase letterspaced
      kicker in the accent colour, a 104px extra-bold headline with a coloured full
      stop, and a filled button beside a ghost link. That is the single most
      reproduced hero on the web, and a reader recognises the shape of it before
      reading a word of it — which is exactly the problem, because the words are the
      part of this site worth reading.

      What replaces it is a catalogue opening: a column of mono metadata on the left, a
      serif line on the right, and one thing to click. */}
  <section class="hero">
    <div class="hero__inner wrap spread">
      <div class="spread__meta">
        <dl>
          <dt>Index</dt>
          <dd>{count} {count === 1 ? 'entry' : 'entries'}</dd>
          <dt>Made by</dt>
          <dd>One person</dd>
          <dt>Price</dt>
          <dd>Free, always</dd>
        </dl>
      </div>

      <div class="hero__copy">
        <h1 class="display display--hero">Everything I make ends up here.</h1>
        <p class="lead">
          Apps, tools, and whatever else I end up making — each with a page that says
          plainly what it does and what it doesn't.
        </p>
        <div class="hero__actions">
          <a class="btn btn--primary" href="#work">See the work</a>
          <a class="textlink" href="/about/">What this is <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="work wrap" id="work">
    <header class="spread">
      <p class="spread__meta">01 — Work</p>
      <div class="sec">
        <h2 class="display display--sec sec__title">The work</h2>
        <p class="sec__note">
          {count === 1
            ? 'One so far. Things get listed here when they work, not when they are announced.'
            : 'Everything here is finished enough to use. Things get listed when they work, not when they are announced.'}
        </p>
      </div>
    </header>

    {feature && (
      <article class="feature spread">
        {/* The metadata that used to be pill-shaped badges scattered over the card.
            Set as a specimen label in the margin, which is what it always was. */}
        <div class="spread__meta feature__meta">
          <dl>
            <dt>Kind</dt>
            <dd>{feature.data.category}</dd>
            <dt>Status</dt>
            <dd>{feature.data.status === 'beta' ? 'Beta' : 'Live'}</dd>
            <dt>Price</dt>
            <dd>Free</dd>
          </dl>
        </div>

        <div class="feature__body">
          <div class="feature__text">
          <h3 class="feature__name">
            <a href={`/apps/${feature.data.slug}/`}>{feature.data.name}</a>
            {feature.data.nativeName && (
              <span class="feature__native">{feature.data.nativeName}</span>
            )}
          </h3>

          <p class="feature__tagline">{feature.data.tagline}</p>
          {feature.data.audience && (
            <p class="feature__audience">{feature.data.audience}</p>
          )}
          <PlatformIcons platforms={feature.data.platforms} />

          <div class="feature__links">
            <a class="btn btn--primary" href={`/apps/${feature.data.slug}/`}>
              Open {feature.data.name}
            </a>
            {featureGuide && (
              <a class="textlink" href={`/apps/${feature.data.slug}/guide/`}>
                See how it works <span aria-hidden="true">→</span>
              </a>
            )}
          </div>

          </div>

          {/* The screenshot sits beside the text, not under it, and it is capped at the
              width it was captured at. It is a phone screen: card.png is 780px wide for
              a 390px layout, so anything past ~390 CSS px is upscaling a picture of a
              phone until it looks like a zoom rather than a screenshot. "Show the
              artifact big" means give it room and weight, not magnification. */}
          <a class="feature__shot" href={`/apps/${feature.data.slug}/`} tabindex="-1" aria-hidden="true">
            <Preview name={feature.data.name} icon={feature.data.icon} card={feature.data.card} />
          </a>
        </div>
      </article>
    )}

    {grouped.map(([label, items]) => (
      <section class="group spread">
        <p class="spread__meta">{label} — {items.length}</p>
        <div class="grid" data-count={Math.min(items.length, 3)}>
          {items.map((app) => <AppCard app={app} />)}
        </div>
      </section>
    ))}
  </section>

  {/* A dark band to break a long light page — the one inversion left on the site, now
      that the hero has given it up. The keys are set in the display serif rather than
      in extra-bold sans, and the lead above them is mono instead of accent-coloured. */}
  <section class="band">
    <div class="band__inner wrap spread">
      <p class="spread__meta band__lead">True of everything here</p>
      <ul class="band__list">
        {stance.map((s) => (
          <li>
            <p class="band__k">{s.k}</p>
            <p class="band__v">{s.v}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <OneTrueThing />
</Base>

<style>
  /* ---------- hero ---------- */
  .hero { padding-block: clamp(56px, 9vw, 116px) clamp(40px, 6vw, 72px); }
  /* The measure belongs on each element, never on the block that holds them. Capping
     .hero__copy capped the paragraph too, and a 46ch lead inside a 17ch parent wraps
     into seven two-word lines that look like a mistake — because they are one. */
  .hero__copy { max-width: none; }
  .hero__copy .display--hero { max-width: 13ch; }
  .hero .lead { margin-top: 28px; max-width: 44ch; }
  .hero__actions {
    margin-top: 34px;
    display: flex; align-items: center; flex-wrap: wrap; gap: 14px 26px;
  }

  .work { margin-top: clamp(40px, 6vw, 72px); }

  /* ---------- the featured work ---------- */
  .feature { margin-top: clamp(30px, 4vw, 52px); }
  .feature__meta { padding-top: 0.9em; }

  .feature__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(32px, 4.6vw, 52px);
    font-weight: 400; letter-spacing: -0.012em; line-height: 1.02;
    display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap;
  }
  .feature__name a { color: inherit; text-decoration: none; }
  .feature__name a:hover { color: var(--accent); }
  .feature__native {
    font-family: var(--font);
    font-size: clamp(14px, 1.4vw, 17px); font-weight: 500; color: var(--ink-soft);
  }
  .feature__tagline {
    margin: 16px 0 16px;
    max-width: 46ch;
    font-size: clamp(17px, 1.8vw, 20px);
    line-height: 1.5;
    color: var(--ink-soft);
    text-wrap: pretty;
  }
  /* Who it is for. The rule beside it used to be 2px of accent — the fourth accent
     object on a page that is allowed one. A quiet rule says "different kind of
     sentence" just as clearly without spending the colour. */
  .feature__audience {
    margin: 0 0 20px;
    max-width: 46ch;
    padding-left: 15px;
    border-left: 1px solid var(--rule);
    font-size: clamp(15px, 1.5vw, 16.5px);
    line-height: 1.5;
    color: var(--ink);
    text-wrap: pretty;
  }
  .feature__links {
    margin-top: 26px;
    display: flex; align-items: center; flex-wrap: wrap; gap: 14px 24px;
  }
  .feature__body { display: grid; gap: clamp(30px, 4vw, 44px); align-items: start; }
  @media (min-width: 1040px) {
    .feature__body { grid-template-columns: minmax(0, 1fr) 340px; column-gap: 56px; }
  }
  .feature__shot {
    display: block;
    padding: 9px;
    max-width: 380px;
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--r-lg);
  }

  /* ---------- the grid, for everything after the first ---------- */
  .group { margin-top: clamp(44px, 6vw, 72px); }
  .grid {
    display: grid;
    gap: var(--gap);
    grid-template-columns: 1fr;
  }
  @media (min-width: 620px) and (max-width: 860px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1000px) { .grid { grid-template-columns: repeat(2, 1fr); } }

  /* ---------- the dark band ---------- */
  .band {
    margin-block: clamp(72px, 10vw, 120px) 0;
    background: var(--panel);
    color: #fff;
    padding-block: clamp(52px, 7vw, 84px);
  }
  .band__lead { color: rgba(255, 255, 255, 0.5); }
  .band__list {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: clamp(26px, 3vw, 40px);
  }
  @media (min-width: 760px) { .band__list { grid-template-columns: repeat(3, 1fr); } }
  .band__list li { border-top: 1px solid rgba(255, 255, 255, 0.18); padding-top: 20px; }
  .band__k {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(23px, 2.6vw, 30px);
    font-weight: 400; letter-spacing: -0.005em;
  }
  .band__v {
    margin: 10px 0 0;
    font-size: 15px; line-height: 1.6;
    color: rgba(255, 255, 255, 0.66);
  }
</style>
