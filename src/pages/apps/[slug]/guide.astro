---
/* The walkthrough, laid out the way publik lays out an install guide.
 *
 * ── What publik's guide page does, and which parts are here ──
 * A breadcrumb TRAIL rather than one crumb (All apps / Ghost / Install / macOS), a
 * headline and a lead, a "What you end up with" card carrying a short row of facts, a
 * "Read this first" callout with the caveats, then numbered steps — a dark number
 * badge, a bold title, a line of body, and a green ✓ line saying what you should be
 * looking at if it worked.
 *
 * All of that maps onto this site's guide schema almost exactly: `before` is the
 * callout, `steps` are the steps, and `note` is the ✓ line. What does not map is
 * publik's fact row, which reads `Time · Steps · Cost` — **`Steps` and `Cost` are real
 * here and `Time` is not.** The step count is the length of an array and the price is
 * a field; how long it takes somebody is a number nobody has measured, and inventing
 * it would be CLAUDE.md hard rule 1 in a place it would never be checked. Two facts,
 * not three.
 *
 * The other difference is the screenshots. publik's steps are text only; every step
 * here carries a real capture of the running build, taken by tools/capture-guide.mjs,
 * and that is the whole point of the page. See CLAUDE.md § How to add a guide — never
 * add a step for a screen you have not seen.
 */
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';

export async function getStaticPaths() {
  const [apps, guides] = await Promise.all([getCollection('apps'), getCollection('guides')]);
  return guides
    .map((guide) => {
      const app = apps.find((a) => a.data.slug === guide.data.app);
      return app ? { params: { slug: app.data.slug }, props: { app, guide } } : null;
    })
    .filter(Boolean) as any[];
}

const { app, guide } = Astro.props;
const a = app.data;
const g = guide.data;
const img = (name: string) => `/assets/${a.slug}/guide/${name}.png`;
const primary = a.downloads[0];

// Both of these are read off the content, not typed. See the note above about the
// third fact publik prints here and this page does not.
const stepCount = g.steps.length + g.after.length;

// Cost and Account come from the app's own fields and the sentence above them from the
// guide, because this template is shared. They used to be typed here in LOGGER's terms —
// free, no connection, no account, "on your own phone" — which the first guide for an app
// that needs a connection or an account would have printed as fact.
const cost = a.price === 'free' ? 'Free' : a.price;
const account = a.privacy === 'account-required' ? 'Required' : 'None';
---
<Base title={`${g.title} — doubleem`} description={g.lead}>
  <header class="top wrap">
    <nav class="trail" aria-label="Breadcrumb">
      <a href="/apps/">All work</a>
      <span aria-hidden="true">/</span>
      <a href={`/apps/${a.slug}/`}>{a.name}</a>
      <span aria-hidden="true">/</span>
      <b>Guide</b>
    </nav>
    <h1>{g.title}</h1>
    <p class="lead">{g.lead}</p>
  </header>

  <div class="wrap">
   <div class="read">
    {/* publik's "What you end up with" card: what you have at the end, then a short
        row of facts under a rule. Only facts that can be counted go in that row. */}
    <section class="outcome glass reveal" data-glow>
      <h2 class="outcome__head">What you end up with</h2>
      <p class="outcome__body">{g.outcome}</p>
      <dl class="outcome__facts">
        <div>
          <dt>Steps</dt>
          <dd><span class="data">{stepCount}</span></dd>
        </div>
        <div>
          <dt>Cost</dt>
          <dd>{cost}</dd>
        </div>
        <div>
          <dt>Account</dt>
          <dd>{account}</dd>
        </div>
      </dl>
    </section>

    {/* publik's "Read this first" — the caveats, before anybody starts. */}
    <section class="first reveal">
      <h2 class="first__head">{g.before.heading}</h2>
      <p class="first__body">{g.before.body}</p>
      <ul class="first__list">{g.before.items.map((i: string) => <li>{i}</li>)}</ul>
    </section>

    <section class="steps" aria-label="Setup, step by step">
      <h2 class="steps__head reveal">Set {a.name} up</h2>
      <ol class="steps__list">
        {g.steps.map((s: any, i: number) => (
          <li class="step reveal">
            <span class="step__n" aria-hidden="true">{i + 1}</span>
            <div class="step__copy">
              <p class="step__kicker">{s.kicker}</p>
              <h3 class="step__title">{s.title}</h3>
              <p class="step__body">{s.body}</p>
              {/* publik's green confirmation line: what you should be looking at if it
                  worked. `note` is the only field that carries that here, and it is
                  optional, so a step without one simply has no line. */}
              {s.note && (
                <p class="step__note"><span aria-hidden="true">✓</span> {s.note}</p>
              )}
            </div>
            <div class="step__shot reveal--wipe">
              <img src={img(s.image)} alt={s.alt} width="390" height="844"
                   loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
            </div>
          </li>
        ))}
      </ol>
    </section>

    {g.after.length > 0 && (
      <section class="steps" aria-label="Using the app">
        <h2 class="steps__head reveal">Once it is set up</h2>
        <ol class="steps__list" style={`counter-reset: step ${g.steps.length}`}>
          {g.after.map((s: any, i: number) => (
            <li class="step reveal">
              <span class="step__n" aria-hidden="true">{g.steps.length + i + 1}</span>
              <div class="step__copy">
                <p class="step__kicker">{s.kicker}</p>
                <h3 class="step__title">{s.title}</h3>
                <p class="step__body">{s.body}</p>
                {s.note && (
                  <p class="step__note"><span aria-hidden="true">✓</span> {s.note}</p>
                )}
              </div>
              <div class="step__shot reveal--wipe">
                <img src={img(s.image)} alt={s.alt} width="390" height="844"
                     loading="lazy" decoding="async" />
              </div>
            </li>
          ))}
        </ol>
      </section>
    )}

    <section class="end glass reveal" data-glow>
      <h2 class="end__head">Get it</h2>
      <p class="end__body">
        {a.name} is free, works offline, and keeps everything on your own phone.
      </p>
      <div class="end__actions">
        <a class="btn btn--primary" href={primary.href}>{primary.label}</a>
        <a class="btn btn--ghost" href={`/apps/${a.slug}/`}>Read more about {a.name}</a>
      </div>
    </section>
   </div>
  </div>
</Base>

<style>
  /* ---------- the head ---------- */
  .top {
    padding-block: calc(var(--head-h) + clamp(16px, 3vw, 40px)) clamp(22px, 3vw, 34px);
  }
  /* A trail, not a single crumb. publik prints the whole path with the current page in
     bold at the end, which on a page three levels down is the difference between
     knowing where you are and knowing only where you can go back to. */
  .trail {
    margin: 0 0 22px;
    display: flex; align-items: center; flex-wrap: wrap; gap: 8px;
    font-size: 14px; color: var(--ink-soft);
  }
  .trail a { color: inherit; text-decoration-color: var(--rule); text-underline-offset: 3px; }
  .trail a:hover { color: var(--ink); text-decoration-color: var(--accent); }
  .trail span { opacity: .45; }
  .trail b { color: var(--ink); font-weight: 600; }
  /* 22px on a phone, and the lowest of everything measured. A breadcrumb is a row of
     links rather than a sentence, so the inline exception does not cover it. */
  @media (pointer: coarse) {
    .trail { gap: 4px; }
    .trail a { padding-block: 11px; }
  }

  .top h1 {
    margin: 0;
    max-width: 18ch;
    font-family: var(--font-display);
    font-size: clamp(34px, 5.6vw, 58px);
    font-weight: 400; letter-spacing: var(--track-display); line-height: 1.02;
    text-wrap: balance;
  }
  .top .lead { margin-top: 18px; max-width: 54ch; }

  /* Everything below the head is a reading column, the way publik narrows its guide.
     A plain block inside .wrap — `class="wrap read"` on one element makes the two
     fight, centring the column and applying the page padding twice. See the longer
     note in apps/[slug].astro. */
  .read { max-width: 820px; }

  /* ---------- what you end up with ---------- */
  .outcome { padding: clamp(20px, 2.6vw, 28px); }
  .outcome__head {
    margin: 0;
    font-family: var(--font);
    font-size: 12.5px; font-weight: 600; letter-spacing: 0.02em;
    color: var(--ink-soft);
  }
  .outcome__body { margin: 10px 0 0; max-width: 58ch; line-height: 1.55; }
  /* The fact row. Three, and every one of them is read off the content or off a field
     — see the note at the top of this file about the fourth publik prints. */
  .outcome__facts {
    margin: 20px 0 0; padding-top: 18px;
    border-top: 1px solid var(--hairline);
    display: flex; flex-wrap: wrap; gap: 14px 44px;
  }
  .outcome__facts dt { font-size: 12.5px; color: var(--ink-soft); }
  .outcome__facts dd {
    margin: 4px 0 0;
    font-family: var(--font-display);
    font-size: 21px; font-weight: 400; letter-spacing: var(--track-tight);
  }

  /* ---------- read this first ---------- */
  .first {
    margin-top: clamp(26px, 3.5vw, 40px);
    padding: 20px 22px;
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-left: 3px solid var(--accent);
    border-radius: var(--r-md);
  }
  .first__head {
    margin: 0;
    font-family: var(--font-display);
    font-size: 21px; font-weight: 400; letter-spacing: var(--track-tight);
  }
  .first__body { margin: 10px 0 0; color: var(--ink-soft); line-height: 1.55; }
  .first__list { margin: 12px 0 0; padding-left: 1.15em; color: var(--ink-soft); line-height: 1.55; }
  .first__list li { margin-bottom: 6px; }

  /* ---------- the steps ---------- */
  .steps { margin-top: clamp(40px, 6vw, 64px); }
  .steps__head {
    margin: 0 0 8px;
    font-family: var(--font-display);
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 400; letter-spacing: var(--track-display); line-height: 1.08;
  }
  .steps__list { list-style: none; margin: 0; padding: 0; }

  /* One step: the number in its own narrow column, the copy beside it, the capture
     under both on a phone and to the right on a wide screen. The hairline between
     steps is publik's, and it does more work than a gap would — it says these are a
     sequence rather than a set of cards. */
  .step {
    padding: clamp(22px, 3vw, 30px) 0;
    border-top: 1px solid var(--hairline);
    display: grid;
    grid-template-columns: 30px minmax(0, 1fr);
    column-gap: 16px;
    row-gap: 18px;
  }
  .step:last-child { border-bottom: 1px solid var(--hairline); }
  @media (min-width: 760px) {
    .step { grid-template-columns: 30px minmax(0, 1fr) 208px; column-gap: 22px; }
  }

  /* The number badge. Tabular figures so 1 and 11 sit on the same centre. */
  .step__n {
    grid-column: 1;
    display: grid; place-items: center;
    width: 30px; height: 30px;
    border-radius: 9px;
    background: var(--accent);
    color: var(--accent-ink);
    font-size: 14px; font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .step__copy { grid-column: 2; min-width: 0; }
  .step__kicker {
    margin: 0 0 4px;
    font-size: 12.5px; font-weight: 500; color: var(--ink-soft);
  }
  .step__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(19px, 2vw, 23px);
    font-weight: 400; letter-spacing: var(--track-tight); line-height: 1.2;
  }
  .step__body { margin: 8px 0 0; color: var(--ink-soft); line-height: 1.55; text-wrap: pretty; }
  /* publik's confirmation line: what you are looking at if it worked. It is the one
     place on this page the accent appears as text, and it earns it by being the thing
     the reader is checking themselves against. */
  .step__note {
    margin: 12px 0 0;
    display: flex; gap: 8px;
    font-size: 14px; font-weight: 500; line-height: 1.5;
    color: var(--accent);
  }
  .step__note span { flex: none; }

  /* The capture. Full width under the copy on a phone, a fixed column beside it above
     760px — and capped either way at the 390px it was taken at. */
  .step__shot { grid-column: 2; }
  /* Above the breakpoint the capture moves into its own 208px column, and THAT is what
     sizes it — the image is width: 100% of whatever column it is in. There is no
     `max-width: 208px` here any more: it was added with the fix below, it never applied
     (the base rule is later in the file at equal specificity, so it always won), and
     desktop was correct anyway because the column governs. A dead rule that looks
     load-bearing is worse than no rule. */
  @media (min-width: 760px) {
    .step__shot { grid-column: 3; grid-row: 1; }
  }
  /* ── The capture fills its column, whatever that column is ──
     This carried `max-width: 208px` unconditionally — the width of the side column it
     sits in above 760px. On a phone, where it is stacked under the copy and has the
     whole column, that rendered it at 208px inside a 289px slot and left 28% of the
     width empty. Measured on a Galaxy S24 Ultra: the guide exists to show you the
     screen, and the phone is where somebody actually follows it.

     The only cap left is 390px, which is not a layout choice — it is the width the
     capture was taken at, past which it would be magnified rather than shown. See
     DESIGN.md § The app card. */
  .step__shot img {
    width: 100%; max-width: 390px; height: auto; display: block;
    border: 1px solid var(--hairline);
    border-radius: var(--r-md);
    background: var(--ground);
  }

  /* ---------- the end ---------- */
  .end { margin-top: clamp(40px, 6vw, 64px); padding: clamp(22px, 3vw, 32px); }
  .end__head {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(22px, 2.6vw, 28px);
    font-weight: 400; letter-spacing: var(--track-tight);
  }
  .end__body { margin: 10px 0 0; max-width: 54ch; color: var(--ink-soft); }
  .end__actions { margin-top: 20px; display: flex; flex-wrap: wrap; gap: 12px; }
</style>
