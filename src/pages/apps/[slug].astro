---
/* One piece of work, its own page, laid out the way publik lays out an app.
 *
 * ── The shape, and what it is answering ──
 * publik's app page opens on the app's own screenshot blurred into the background, a
 * very large name, one line of what it does, a status pill, then the screenshot beside
 * a sticky rail of every way to get it. Everything after that narrows to a reading
 * column. That order is right for this site too: CLAUDE.md § What this is says a
 * stranger asks what it is, then whether they can have it, then whether to trust it —
 * and this page now answers them in that order without being told to scroll.
 *
 * ── What publik puts here that this page must not ──
 *  · `by @mann` with an avatar. CLAUDE.md § The traps: the developer's name does not go
 *    on app pages. Logger deliberately keeps it off the documents it produces too.
 *    Contact belongs on the about page, once.
 *  · `✓ PUBLIK VERIFIED`. There is no verifier here. A badge implying a third party
 *    checked this would be the most damaging thing on the page. The pill carries
 *    `status` instead, which is a field, not a claim about who audited it.
 *  · `Vote on Ghost ▲ 51 ▼` and `Compared with GhostMe $12.95/mo`. A score and a rival's
 *    price. No accounts, nothing to count, nothing to compare against — hard rule 1.
 *  · A LIGHT README card on a dark page. publik's is white and it looks good, but
 *    DESIGN.md § The atmosphere records that the last light/dark inversion was spent on
 *    purpose. The detail card is glass, like every other panel on the site.
 *
 * What fills the space those leave is the thing publik has no equivalent for: the
 * verify list. A marketplace prints a number you have to believe; this prints a claim
 * and the way to check it.
 */
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PhoneDevice from '../../components/PhoneDevice.astro';
import { themeColor } from '../../theme-color';
import { contact, siteClaim } from '../../site';
import { fill, noticeIsLive, releaseFacts } from '../../release';
import { languageNames as langNames, platformLong as platformNames } from '../../labels';

export async function getStaticPaths() {
  const [apps, guides] = await Promise.all([getCollection('apps'), getCollection('guides')]);
  // The slug is the URL and the filename is what a person edits; if they disagree, the
  // page for apps/foo.md quietly appears at /apps/bar/. One rule, checked here.
  // (Not app.id — the glob loader takes the id FROM `slug`, so the two always agree.)
  for (const app of apps) {
    const file = app.filePath?.split('/').pop()?.replace(/\.md$/, '');
    if (file !== app.data.slug) {
      throw new Error(`apps/${file}.md says slug: ${app.data.slug} — they must match`);
    }
  }
  return apps.map((app) => ({
    params: { slug: app.data.slug },
    props: { app, hasGuide: guides.some((g) => g.data.app === app.data.slug) },
  }));
}

const { app, hasGuide } = Astro.props;
const d = app.data;
const { Content } = await render(app);

// Release facts — version, size, hash — come from `release:` and the file itself, and
// prose asks for them by token. See src/release.ts.
const facts = releaseFacts(d.release);
const f = (text: string) => fill(text, facts);

// The update notice, if there is one and its last day has not passed. Its badge goes on
// one download button, and links to the section rather than wrapping it: a link cannot
// sit inside a link, and the button still has to download.
const notice = noticeIsLive(d.notice) ? d.notice : undefined;
const badgeOn = notice && (notice.download ?? d.release?.apk ?? d.downloads[0].href);
const noticeParas = notice ? notice.body.split(/\n\s*\n/).map((p: string) => f(p.trim())) : [];

const privacyLine =
  d.privacy === 'on-device'
    ? 'Stays on your device — no account, no server'
    : 'Requires an account';

// Phone screens and sheets of paper are laid out differently, so they are separated here
// rather than in CSS. They were one grid at first, with the page spanning every column —
// which forced the whole page to 644px on a 390px phone and made it scroll sideways,
// because a full-column span inside a horizontally scrolling strip has nothing sane to
// span. Two lists, no spans, and each shape gets the treatment it needs.
const phoneShots = d.screenshots.filter((s: any) => s.shape !== 'page');
const pageShots = d.screenshots.filter((s: any) => s.shape === 'page');

// The hero device shows this app's own capture, in the real handset — see the note on
// the hero below for why the page now uses the device rather than a flat mount.
const heroScreen = d.card
  ? [{ src: d.card, alt: `${d.name} running on a phone`, statusColor: themeColor(d.slug) }]
  : [];
---
<Base title={`${d.name} — doubleem`} description={d.audience ? `${d.tagline} ${d.audience}` : d.tagline} image={d.icon}>
  <article>
    {/* ── The hero ──
        The device is the real one: the same CSS Galaxy the homepage uses, with the
        tilt, the idle float and the ambient bloom, showing this app's own capture. It
        used to be a flat bordered mount, which was a strange thing to put on the page
        that is actually ABOUT the app while the front page got the good treatment.
        Reusing the component costs no new motion vocabulary and no new markup — the
        tilt is the same `data-tilt-area` region /motion.js already watches for.

        The backdrop under it is this app's capture blurred past reading and dimmed. It
        is decoration and carries no meaning, like the glow and the grid: no text, no
        pointer, and the page is complete without it. Deliberately faint — both apps
        here are LIGHT on screen, so their captures blur to a pale wash and turn the top
        of the page milky at any real opacity. Measured on the built page, not guessed:
        if you raise --shot-a, measure the headline's contrast again.

        What publik puts here and this page must not is listed at the top of the file. */}
    <div class="apphead" data-tilt-area>
      {d.card && (
        <div class="apphead__bg" aria-hidden="true" style={`--shot: url('${d.card}')`}></div>
      )}
      <div class="wrap apphead__inner">
        <div class="apphead__copy">
          <p class="crumb"><a href="/apps/"><span aria-hidden="true">←</span> All work</a></p>

          <p class="pill">
            <span class="pill__dot" aria-hidden="true"></span>
            {d.category}<i>·</i>{d.status === 'beta' ? 'Beta' : 'Live'}<i>·</i>Free
          </p>

          <h1 class="apphead__name">
            {d.name}
            {d.nativeName && <span class="apphead__native">{d.nativeName}</span>}
          </h1>
          <p class="apphead__tagline">{d.tagline}</p>
          {d.audience && <p class="apphead__audience">{d.audience}</p>}

          {/* The ways to get it sit beside the name now rather than in a sidebar. It is
              the site's second question — can I have it, and what does it cost — and it
              should not need a scroll. */}
          <div class="apphead__actions">
            {d.downloads.map((dl: any, i: number) => (
              <span class="getit">
                <a class={`btn ${i === 0 ? 'btn--primary' : 'btn--ghost'}`} href={dl.href}>
                  <span class="btn__label">
                    {dl.label}
                    {dl.note && <span class="btn__note">{f(dl.note)}</span>}
                  </span>
                </a>
                {notice && dl.href === badgeOn && (
                  <a class="getit__badge" href={`#${notice.id}`}>{f(notice.badge)}</a>
                )}
              </span>
            ))}
          </div>

          {(hasGuide || d.sourceUrl) && (
            <p class="apphead__links">
              {hasGuide && (
                <a href={`/apps/${d.slug}/guide/`}>See how it works <span aria-hidden="true">→</span></a>
              )}
              {d.sourceUrl && (
                <a href={d.sourceUrl}>Read the source <span aria-hidden="true">↗</span></a>
              )}
            </p>
          )}
        </div>

        {heroScreen.length > 0 && (
          <div class="apphead__device">
            <PhoneDevice screens={heroScreen} />
          </div>
        )}
      </div>
    </div>

    {/* The facts, as a band across the full measure rather than a column in a sidebar.
        Every one is a field or the length of a list — nothing here is counted that
        cannot be counted. */}
    <div class="wrap">
      <dl class="facts">
        <div><dt>Price</dt><dd class="facts__free">Free</dd></div>
        <div><dt>Your data</dt><dd>{privacyLine}</dd></div>
        <div><dt>Runs on</dt><dd>{d.platforms.map((p: string) => platformNames[p] ?? p).join(', ')}</dd></div>
        {d.languages && (
          <div>
            <dt>Languages<span class="facts__n data">{d.languages.length}</span></dt>
            <dd>{d.languages.map((l: string) => langNames[l] ?? l).join(' · ')}</dd>
          </div>
        )}
      </dl>
    </div>

    {/* Everything from here narrows to a reading column. publik does the same and it is
        the reason its app pages stay readable after a full-width hero: a 1140px measure
        is right for a grid of cards and much too wide for prose. */}
    <div class="wrap">
     <div class="read">
      {/* Before everything else in the column, because it is the thing to read before
          downloading — the badge on the button links straight here. No .reveal: a reader
          who arrives by the anchor must see it at once, not watch it fade in. */}
      {notice && (
        <section class="notice block" id={notice.id} aria-labelledby={`${notice.id}-head`}>
          <p class="notice__tag">{f(notice.badge)}</p>
          <h2 class="notice__head" id={`${notice.id}-head`}>{f(notice.heading)}</h2>
          {noticeParas.map((p: string) => <p>{p}</p>)}
        </section>
      )}

      {hasGuide && (
        <a class="bigrow" href={`/apps/${d.slug}/guide/`}>
          <span>How to use {d.name}, screen by screen</span>
          <span aria-hidden="true">→</span>
        </a>
      )}

      {d.screenshots.length > 0 && (
        <section class="block" aria-label={`What ${d.name} looks like`}>
          <h2 class="sec__head reveal">What it looks like</h2>
          {phoneShots.length > 0 && (
            <ol class="screens__strip">
              {phoneShots.map((s: any) => (
                <li class="screens__item reveal--wipe">
                  <img src={s.src} alt={s.alt} loading="lazy" decoding="async" />
                  {s.caption && <p class="screens__cap">{s.caption}</p>}
                </li>
              ))}
            </ol>
          )}

          {pageShots.map((s: any) => (
            <figure class="sheet reveal--wipe">
              <img src={s.src} alt={s.alt} loading="lazy" decoding="async" />
              {s.caption && <figcaption class="screens__cap">{s.caption}</figcaption>}
            </figure>
          ))}
        </section>
      )}

      {/* publik's README card, in this site's one theme rather than in white. The
          header bar is the part worth copying: it says what you are about to read and
          offers the source of it in the same line. */}
      <section class="block">
        <div class="detail glass">
          <div class="detail__bar">
            <span class="detail__label">In detail</span>
            {d.sourceUrl && (
              <a class="detail__src" href={d.sourceUrl}>Read the source <span aria-hidden="true">↗</span></a>
            )}
          </div>
          <div class="detail__body prose">
            <Content />
          </div>
        </div>
      </section>

      {d.platformNotes.length > 0 && (
        <section class="block">
          <h2 class="sec__head reveal">Where it runs, and what changes</h2>
          <p class="sec__lead">The same app either way.</p>
          <dl class="where__list">
            {d.platformNotes.map((p: any) => (
              <div class="where__row reveal">
                <dt>{platformNames[p.platform] ?? p.platform}</dt>
                <dd>{f(p.note)}</dd>
              </div>
            ))}
          </dl>
        </section>
      )}

      {/* Where a marketplace would put an install counter or a star rating, this site
          puts the claim and the way to check it. Counters and ratings are numbers a
          visitor has to believe; these are things they can confirm. Never add an entry
          here that has not been checked on the shipping build. The section always
          renders now, because the site's own claim closes it on every app page. */}
      <section class="block">
          <h2 class="sec__head reveal">Don't take my word for it</h2>
          <p class="sec__lead">
            What this page claims, and how to check each one yourself.
          </p>
          <ul class="verify__list">
            {d.verify.map((v: any) => (
              <li class="verify__item reveal">
                <p class="verify__claim">{f(v.claim)}</p>
                <p class="verify__how">{f(v.how)}</p>
              </li>
            ))}
            {/* The site's own claim, last, on every app page — see src/site.ts. */}
            <li class="verify__item reveal">
              <p class="verify__claim">{siteClaim.claim}</p>
              <p class="verify__how">{siteClaim.how}</p>
            </li>
          </ul>
      </section>

      {/* The words come from the app, not from here. This aside used to carry LOGGER's —
          "this does not match my payslip", "a wage figure that is quietly wrong" — on
          every app page, so HANGIL, which has no payslip and computes no wages, asked
          its readers to report a mismatched payslip. Copy that is only true of one app
          is that app's copy; see `wrong` in content.config.ts.

          The fallback says nothing an app could contradict.

          Note the comment sits OUTSIDE the `&& (` below: the body of a JSX conditional
          holds exactly one element, and a comment in there is a second expression. That
          is a compile error, not a warning. */}
      {(contact.formUrl || contact.issuesUrl) && (
        <aside class="wrong reveal">
          <h2>{d.wrong ? f(d.wrong.heading) : 'If something here is wrong'}</h2>
          <p>
            {(d.wrong && f(d.wrong.body)) ??
              'Tell me. You do not need to be sure it is a bug — noticing that something does not match what you expected is enough, and it is the most useful thing you can send me.'}
          </p>
          <p class="wrong__links">
            {contact.formUrl && <a href={contact.formUrl}>Report a problem</a>}
            {contact.formUrl && contact.issuesUrl && <span aria-hidden="true"> · </span>}
            {contact.issuesUrl && <a href={contact.issuesUrl}>Open an issue</a>}
          </p>
        </aside>
      )}
     </div>
    </div>
  </article>
</Base>

<style>
  article { --col-side: 300px; --read: 760px; }

  /* ---------- the head ---------- */
  .apphead {
    position: relative;
    padding-block: calc(var(--head-h) + clamp(16px, 3vw, 40px)) clamp(26px, 4vw, 44px);
    /* The backdrop is wider and taller than the text it sits behind; without this it
       adds a horizontal scrollbar exactly the way the device's bloom did on the
       homepage. Same fix, same reason — see the note on .hero in index.astro. */
    overflow-x: clip;
  }
  /* The app's own capture, blurred past reading and dimmed to a suggestion. The mask
     fades it out downward so it belongs to the head rather than to the whole page. */
  .apphead__bg {
    --shot-a: 0.16;
    position: absolute;
    inset: -20% -10% 0;
    background-image: var(--shot);
    background-size: cover;
    background-position: top center;
    filter: blur(72px) saturate(1.3);
    opacity: var(--shot-a);
    pointer-events: none;
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 42%, transparent 92%);
    mask-image: linear-gradient(to bottom, #000 0%, #000 42%, transparent 92%);
  }
  .apphead__inner { position: relative; }

  .crumb { margin: 0 0 20px; font-size: 14px; }
  .crumb a {
    color: var(--ink-soft);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 2px;
    transition: color 160ms var(--ease), border-color 160ms var(--ease);
  }
  .crumb a:hover { color: var(--ink); border-bottom-color: var(--accent); }
  /* A standalone back link that happens to live in a <p>, not a link inside a
     sentence — so it takes the 44px floor rather than the inline exception. */
  @media (pointer: coarse) {
    .crumb a { display: inline-flex; align-items: center; min-height: 44px; }
    .apphead__links a { display: inline-flex; align-items: center; min-height: 44px; }
  }

  .apphead .pill { margin: 0 0 18px; }
  .apphead .pill i { font-style: normal; opacity: .5; margin-inline: 7px; }

  .apphead__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(40px, 7.4vw, 76px);
    font-weight: 400; letter-spacing: var(--track-display); line-height: 0.98;
    display: flex; align-items: baseline; gap: 16px; flex-wrap: wrap;
  }
  .apphead__native {
    font-family: var(--font);
    font-size: clamp(15px, 1.6vw, 20px); font-weight: 500; color: var(--ink-soft);
  }
  .apphead__tagline {
    margin: 18px 0 0;
    max-width: 44ch;
    font-size: clamp(17px, 2vw, 22px);
    line-height: 1.45;
    color: var(--ink-soft);
    text-wrap: pretty;
  }
  .apphead__audience {
    margin: 16px 0 0;
    max-width: 48ch;
    padding-left: 15px;
    border-left: 1px solid var(--rule);
    font-size: clamp(15px, 1.5vw, 16.5px);
    line-height: 1.5;
    text-wrap: pretty;
  }

  /* The head is two columns above 900px: the words and the ways to get it on the left,
     the device on the right. It mirrors the homepage hero deliberately — a visitor who
     arrives here from the front page should recognise the shape. 900 is the same number
     PhoneDevice flattens its tilt at; move one and move the other. */
  .apphead__inner { display: grid; gap: clamp(30px, 4vw, 48px); align-items: center; }
  @media (min-width: 900px) {
    .apphead__inner { grid-template-columns: minmax(0, 1fr) auto; column-gap: clamp(36px, 4.5vw, 72px); }
  }
  .apphead__copy { min-width: 0; }
  /* Smaller than the homepage's, because here it shares the row with a headline at
     76px rather than 68px and must not out-shout the name of the thing. */
  .apphead__device { justify-self: center; --phone-size: clamp(210px, 18vw, 262px); }

  .apphead__actions {
    margin-top: 30px;
    display: flex; flex-wrap: wrap; gap: 12px;
  }
  .apphead__actions .btn { min-height: 54px; }

  /* ---------- the update notice ---------- */
  /* The badge is a second link pinned to the button's corner, not a part of it — the
     button downloads and the badge goes to the notice, and a link inside a link is
     invalid HTML that browsers untangle unpredictably. White type on the red, and a
     white stroke round it — the stroke is what lifts it off the mint button and off
     the dark ground alike. The badge pokes 8px past the button's corner and the stroke
     2px more: 10px in all, inside the 12px gap of .apphead__actions, so it never
     touches the button beside it. Measure again if either number moves. */
  .getit { position: relative; display: inline-flex; padding: 10px 8px 0 0; margin: -10px -8px 0 0; }
  .getit__badge {
    position: absolute; top: 0; right: 0;
    display: inline-flex; align-items: center;
    min-height: 24px; padding: 0 9px;
    border-radius: 999px;
    background: var(--alert); color: var(--alert-ink);
    box-shadow: 0 0 0 2px var(--alert-ink);
    font-size: 12px; font-weight: 700; line-height: 1; white-space: nowrap;
    text-decoration: none;
  }
  .getit__badge:hover { text-decoration: underline; text-underline-offset: 2px; }

  .notice {
    padding: 22px;
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-left: 3px solid var(--alert);
    border-radius: var(--r-md);
    scroll-margin-top: calc(var(--head-h) + 14px);
  }
  /* The same pill as the badge, so the reader who followed it sees it again here. */
  .notice__tag {
    display: inline-flex; align-items: center;
    min-height: 24px; margin: 0 0 12px; padding: 0 9px;
    border-radius: 999px;
    background: var(--alert); color: var(--alert-ink);
    font-size: 12.5px; font-weight: 700; line-height: 1;
  }
  .notice__head {
    margin: 0 0 10px; font-family: var(--font-display); font-weight: 400; font-size: 22px;
    letter-spacing: var(--track-tight);
  }
  .notice p:not(.notice__tag) { margin: 0 0 10px; line-height: 1.55; }
  .notice p:last-child { margin-bottom: 0; }
  .apphead__actions .btn__label { display: grid; gap: 2px; text-align: left; }

  .apphead__links {
    margin: 20px 0 0;
    display: flex; flex-wrap: wrap; gap: 10px 26px;
    font-size: 14.5px; font-weight: 600;
  }
  .apphead__links a {
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 2px;
    transition: color 160ms var(--ease), border-color 160ms var(--ease);
  }
  .apphead__links a:hover { color: var(--accent); border-bottom-color: var(--accent); }

  /* ---------- the facts band ---------- */
  /* Across the measure rather than stacked in a sidebar. Rules above and below make it
     a band, which gives the page a beat between the hero and the prose and stops the
     reading column starting cold. Set as rows divided by hairlines, never as tiles —
     tiles here would be the stat row this site refuses to carry, in a different shape. */
  .facts {
    margin: clamp(34px, 4.5vw, 56px) 0 0;
    padding-block: 22px;
    border-block: 1px solid var(--hairline);
    display: grid;
    gap: 22px 40px;
    grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr));
  }
  .facts dt {
    display: flex; align-items: center; gap: 7px;
    font-size: 12.5px; color: var(--ink-soft);
  }
  .facts dd { margin: 5px 0 0; font-size: 15px; line-height: 1.45; text-wrap: pretty; }
  .facts__free { font-weight: 700; }
  /* The count beside the label, in mono because it is a fact the reader could check:
     it is the length of the list printed underneath it. */
  .facts__n {
    font-size: 11.5px;
    padding: 1px 6px;
    border: 1px solid var(--hairline);
    border-radius: var(--r-sm);
    color: var(--ink);
  }

  /* ---------- the reading column ---------- */
  /* A plain block inside .wrap, NOT `class="read wrap"`. On one element those two
     fight: .wrap sets the page measure with auto margins, .read then narrows it — and
     the auto margins centre the narrowed box while .wrap's 91px of side padding is
     applied a second time inside it. Measured before the fix: an 808px box at x=316
     holding 626px of content at x=407. The about page had the identical bug. */
  .read { max-width: var(--read); margin-top: clamp(38px, 5vw, 58px); }
  .block { margin-top: clamp(38px, 5vw, 56px); }
  .block:first-child { margin-top: 0; }

  /* publik's full-width row link, with the arrow pinned to the far edge. It is the
     shape it uses for "How to install Ghost on Mac", and it is a better answer than a
     third button for a route that is important but not the primary one. */
  .bigrow {
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    padding: 18px 22px;
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--r-xl);
    font-size: clamp(15px, 1.7vw, 17px); font-weight: 600;
    text-decoration: none;
    transition: border-color 200ms var(--ease), color 200ms var(--ease);
  }
  .bigrow:hover { border-color: var(--accent); color: var(--accent); }

  .sec__head {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 400; letter-spacing: var(--track-display); line-height: 1.08;
  }
  .sec__lead { margin: 10px 0 0; max-width: 62ch; color: var(--ink-soft); }

  /* A strip that scrolls sideways on a phone and becomes a grid when there is room.
     Scroll snapping keeps a screenshot aligned rather than stranded half off-screen. */
  .screens__strip {
    list-style: none;
    margin: 22px 0 0;
    padding: 0 0 6px;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(196px, 62vw);
    gap: 18px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
  }
  @media (min-width: 700px) {
    /* Columns are capped rather than stretched, and packed to the start. With a 1fr
       maximum, two phone shots in a three-column grid left a visibly empty third cell —
       the grid was sizing to the container instead of to how many screens there are. */
    .screens__strip {
      grid-auto-flow: row;
      grid-template-columns: repeat(auto-fit, minmax(172px, 224px));
      grid-auto-columns: auto;
      justify-content: start;
      overflow-x: visible;
    }
  }
  .screens__item { scroll-snap-align: start; min-width: 0; }
