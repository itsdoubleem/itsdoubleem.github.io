---
/* The page that is not there.
 *
 * There was no 404 on this site at all, so a mistyped URL got whatever GitHub Pages
 * serves by default — a white page in someone else's typeface telling the visitor
 * nothing about where they are. Astro emits src/pages/404.astro to dist/404.html and
 * GitHub Pages serves that automatically; no configuration is needed.
 *
 * publik's is the shape copied here: one very large line, one quiet sentence under it,
 * one filled control back into the catalogue, and nothing else on the page. What is NOT
 * copied is that publik tints the second word of its headline in its accent — DESIGN.md
 * § The second change names "a headline with half its words tinted" as one of the two
 * moves this site had already removed once and must not take back. The button is the
 * one accent object here, as everywhere.
 */
import Base from '../layouts/Base.astro';
---
<Base
  title="Not found — doubleem"
  description="That page is not here. It may have moved, or it may never have existed."
>
  <section class="oops wrap">
    <p class="label">404</p>
    <h1 class="oops__head">This page is not here.</h1>
    <p class="oops__body">
      It may have moved, or it may never have existed. Nothing is lost — everything on
      this site is on one page, and that page is two clicks away at most.
    </p>
    <div class="oops__actions">
      <a class="btn btn--primary" href="/apps/">See the work <span aria-hidden="true">→</span></a>
      <a class="textlink" href="/">Back to the front <span aria-hidden="true">→</span></a>
    </div>
  </section>
</Base>

<style>
  /* The header floats and no longer pushes anything down, so this clears it itself —
     see --head-h in global.css. The page is short, so it is pushed down further than
     the others to sit nearer the middle of the window rather than clinging to the top
     of an otherwise empty screen. */
  .oops {
    padding-block: calc(var(--head-h) + clamp(50px, 12vh, 140px)) clamp(60px, 14vh, 160px);
  }
  .oops__head {
    margin: 0;
    max-width: 16ch;
    font-family: var(--font-display);
    font-size: clamp(38px, 7vw, 72px);
    font-weight: 400; letter-spacing: var(--track-display); line-height: 1.0;
    text-wrap: balance;
  }
  .oops__body {
    margin: 22px 0 0;
    max-width: 48ch;
    font-size: clamp(16px, 1.8vw, 19px);
    line-height: 1.55;
    color: var(--ink-soft);
    text-wrap: pretty;
  }
  .oops__actions {
    margin-top: 34px;
    display: flex; align-items: center; flex-wrap: wrap; gap: 14px 26px;
  }
</style>
